    },
    "widget.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much rent has come in this month and who still owes you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto alquiler has cobrado este mes y quién te debe todavía."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Miete diesen Monat eingegangen ist und wer noch zahlen muss."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de loyers ont été encaissés ce mois-ci et qui vous doit encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto affitto hai incassato questo mese e chi ti deve ancora qualcosa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanta renda recebeu este mês e quem ainda lhe deve."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم إيجارًا حصّلته هذا الشهر ومن لا يزال مدينًا لك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस माह कितना किराया आया और किस पर अभी बकाया है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月已收多少租金,以及谁还欠款。"
          }
        }
      }
    }
  }
