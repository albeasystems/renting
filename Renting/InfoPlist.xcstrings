    "NSUserTrackingUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is used to show more relevant ads. We never sell your personal data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu información se usa para mostrar anuncios más relevantes. Nunca vendemos tus datos personales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten werden verwendet, um relevantere Werbung anzuzeigen. Wir verkaufen deine persönlichen Daten nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données servent à afficher des publicités plus pertinentes. Nous ne vendons jamais vos données personnelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati vengono usati per mostrare pubblicità più pertinenti. Non vendiamo mai i tuoi dati personali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados são usados para exibir anúncios mais relevantes. Nunca vendemos seus dados pessoais."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم بياناتك لعرض إعلانات أكثر صلة. لا نبيع بياناتك الشخصية أبدًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डेटा का उपयोग अधिक प्रासंगिक विज्ञापन दिखाने के लिए किया जाता है। हम आपका व्यक्तिगत डेटा कभी नहीं बेचते।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的数据用于展示更相关的广告。我们绝不会出售你的个人数据。"
          }
        }
      }
    }
  }
}