    "pro.f.alerts.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdue rent, upcoming IBI and fees, contracts ending, deposits to return and rent reviews — with optional notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impagos, IBI y tasas que vencen, contratos que terminan, fianzas por devolver y revisiones de renta, con notificaciones opcionales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überfällige Mieten, anstehende Grundsteuer und Gebühren, auslaufende Verträge, Kautionen und Mietanpassungen – mit optionalen Mitteilungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loyers impayés, taxe foncière et frais à venir, contrats qui se terminent, dépôts à restituer et révisions de loyer, avec notifications optionnelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affitti non pagati, IMU e tasse in scadenza, contratti in chiusura, depositi da restituire e revisioni dell'affitto, con notifiche opzionali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrasos, IPTU e taxas a vencer, contratos terminando, cauções a devolver e reajustes, com notificações opcionais."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيجارات متأخرة، وضريبة عقارية ورسوم مستحقة، وعقود منتهية، وتأمينات للإرجاع، ومراجعات الإيجار — مع إشعارات اختيارية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बकाया किराया, आने वाले संपत्ति कर व शुल्क, खत्म होते अनुबंध, लौटाई जाने वाली जमानत और किराया समीक्षा — वैकल्पिक सूचनाओं सहित।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逾期租金、即将到期的房产税与费用、合同到期、待退押金和租金调整,并可选推送通知。"
          }
        }
      }
    },
