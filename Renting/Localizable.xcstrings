    "exp.supplies.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares what tenants pay for utilities on top of the rent with the bills you pay, to adjust the flat amount you charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara lo que pagan los inquilinos por suministros con las facturas que pagas tú, para ajustar la cantidad fija que repercutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht, was Mieter für Nebenkosten zahlen, mit den Rechnungen, die du zahlst – um die Pauschale anzupassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare ce que les locataires paient pour les charges aux factures que vous réglez, pour ajuster le forfait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta quanto pagano gli inquilini per le utenze con le bollette che paghi tu, per regolare l'importo forfettario."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara o que os inquilinos pagam pelos consumos com as faturas que você paga, para ajustar o valor fixo cobrado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقارن ما يدفعه المستأجرون للمرافق بالفواتير التي تدفعها، لضبط المبلغ الثابت الذي تحمّله."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किरायेदार उपयोगिताओं के लिए जो देते हैं उसकी तुलना आपके बिलों से करता है, ताकि तय राशि समायोजित कर सकें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对比租客支付的水电杂费与你实际支付的账单,便于调整固定收费金额。"
          }
        }
      }
    },
