      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IBI, community, taxes… due this month or next, not paid yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IBI, comunidad, tasas… que vencen este mes o el siguiente y siguen sin pagar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IBI, Hausgeld, Abgaben … in diesem oder im nächsten Monat fällig, noch nicht bezahlt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
