    "rule.vacancy.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts the days since the last tenant left and the rent you are missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta los días desde que se fue el último inquilino y la renta que dejas de ingresar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt die Tage seit dem Auszug des letzten Mieters und die entgangene Miete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte les jours depuis le départ du dernier locataire et le loyer manquant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta i giorni da quando se n'è andato l'ultimo inquilino e il canone che non incassi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta os dias desde que saiu o último inquilino e a renda que deixa de receber."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحسب الأيام منذ مغادرة آخر مستأجر والإيجار الذي تخسره."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आख़िरी किरायेदार के जाने के बाद के दिन और छूटा हुआ किराया गिनता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计自上一位租客搬出后的天数及损失的租金。"
          }
        }
      }
    },
