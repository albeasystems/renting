    "kpi.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charts show the last 12 months up to the month you are viewing. The dashed line marks the average or a healthy goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gráficos muestran los últimos 12 meses hasta el mes que estás viendo. La línea de puntos marca la media o un objetivo sano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diagramme zeigen die letzten 12 Monate bis zum angezeigten Monat. Die gestrichelte Linie markiert den Durchschnitt oder ein gesundes Ziel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les graphiques montrent les 12 derniers mois jusqu'au mois affiché. La ligne pointillée indique la moyenne ou un objectif sain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I grafici mostrano gli ultimi 12 mesi fino al mese che stai guardando. La linea tratteggiata indica la media o un obiettivo sano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gráficos mostram os últimos 12 meses até ao mês que está a ver. A linha tracejada marca a média ou um objetivo saudável."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض الرسوم البيانية آخر 12 شهرًا حتى الشهر الذي تشاهده. يشير الخط المتقطع إلى المتوسط أو إلى هدف سليم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार्ट आपके देखे जा रहे माह तक के पिछले 12 महीने दिखाते हैं। बिंदीदार रेखा औसत या स्वस्थ लक्ष्य दर्शाती है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图表显示截至当前所查看月份的最近 12 个月。虚线表示平均值或健康目标。"
          }
        }
      }
    },
    "kpi.eq.title": {
      "extractionState": "manual",
      "localizations": {
