          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享通知函"
          }
        }
      }
    },
    "upd.letter.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep proof that you sent it (registered mail, or an email with acknowledgement). Applying the update also adds a note to the next receipts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva prueba del envío (burofax o email con acuse). Al aplicar la actualización, los siguientes recibos llevarán también una nota."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre einen Versandnachweis auf (Einschreiben oder E-Mail mit Empfangsbestätigung). Mit der Anpassung tragen die nächsten Quittungen zusätzlich einen Vermerk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez une preuve d'envoi (recommandé ou e-mail avec accusé de réception). L'application de la révision ajoute aussi une note aux prochaines quittances."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva la prova dell'invio (raccomandata o email con ricevuta). Applicando l'adeguamento, le prossime ricevute riporteranno anche una nota."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde prova do envio (carta registada ou email com aviso de receção). Ao aplicar a atualização, os próximos recibos também levarão uma nota."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بإثبات الإرسال (بريد مسجل أو بريد إلكتروني مع إشعار استلام). عند تطبيق التحديث ستحمل الإيصالات التالية ملاحظة أيضًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने का प्रमाण रखें (रजिस्टर्ड डाक या पावती वाला ईमेल)। अद्यतन लागू करने पर अगली रसीदों पर भी नोट जुड़ेगा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保留寄送凭证(挂号信或带回执的邮件)。应用调整后,后续收据也会附上提示。"
          }
        }
      }
    },
    "upd.keep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the rent this year"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la renta este año"
          }
        },
        "de": {
