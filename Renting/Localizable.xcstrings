    "cloud.what.synced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homes, rooms, tenants, collections, expenses, manager fees, rent updates, fianza deposits and your deductible-expense choices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viviendas, habitaciones, inquilinos, cobros, gastos, comisiones del gestor, actualizaciones de renta, depósitos de fianza y tus elecciones de gastos deducibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohnungen, Zimmer, Mieter, Zahlungseingänge, Ausgaben, Verwaltungsprovisionen, Mietanpassungen, Kautionshinterlegungen und deine Auswahl absetzbarer Ausgaben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logements, chambres, locataires, encaissements, dépenses, commissions du gestionnaire, révisions de loyer, dépôts de caution et vos choix de dépenses déductibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immobili, stanze, inquilini, incassi, spese, commissioni del gestore, adeguamenti del canone, depositi della cauzione e le tue scelte di spese deducibili."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imóveis, quartos, inquilinos, cobranças, despesas, comissões do gestor, atualizações de renda, depósitos de fiança e as suas escolhas de despesas dedutíveis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العقارات والغرف والمستأجرون والتحصيل والمصروفات وعمولات المدير وتحديثات الإيجار وإيداعات الضمان واختياراتك للمصروفات القابلة للخصم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवास, कमरे, किरायेदार, वसूली, खर्च, प्रबंधक का कमीशन, किराया अद्यतन, जमानत जमा और कटौती योग्य खर्च के आपके चयन।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房产、房间、租客、收租记录、支出、管理人佣金、租金调整、押金存放记录以及你选择的可抵扣费用。"
          }
        }
      }
    },
    "cloud.what.local": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays on each device: language, currency, your name and tax ID for receipts, alert rules and the app's purchases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en cada dispositivo: idioma, moneda, tu nombre y NIF para los recibos, reglas de alertas y las compras de la app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt auf jedem Gerät: Sprache, Währung, dein Name und deine Steuernummer für Quittungen, Regeln für Hinweise und die Käufe der App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste sur chaque appareil : langue, devise, votre nom et n° fiscal pour les quittances, règles d'alerte et achats de l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta su ogni dispositivo: lingua, valuta, il tuo nome e codice fiscale per le ricevute, regole degli avvisi e acquisti dell'app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica em cada dispositivo: idioma, moeda, o seu nome e NIF para os recibos, regras de alertas e as compras da app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى على كل جهاز: اللغة والعملة واسمك ورقمك الضريبي للإيصالات وقواعد التنبيهات ومشتريات التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर डिवाइस पर ही रहता है: भाषा, मुद्रा, रसीदों के लिए आपका नाम और कर आईडी, अलर्ट नियम और ऐप की खरीदारियाँ।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保留在各设备上:语言、货币、收据上的姓名与税号、提醒规则以及应用内购买。"
          }
        }
      }
    },
    "cloud.privacy.title": {
