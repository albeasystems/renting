    "pdf.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working summary generated by Renting from the data you entered. It is not tax advice: check amounts, reductions and deductibility rules with your tax advisor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen de trabajo generado por Renting con los datos que has introducido. No es asesoramiento fiscal: contrasta importes, reducciones y deducibilidad con tu gestor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsübersicht, von Renting aus deinen Eingaben erstellt. Keine Steuerberatung: Beträge, Ermäßigungen und Absetzbarkeit bitte mit deinem Steuerberater prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synthèse de travail générée par Renting à partir de vos données. Ce n'est pas un conseil fiscal : vérifiez montants, réductions et déductibilité avec votre conseiller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riepilogo di lavoro generato da Renting con i dati inseriti. Non è consulenza fiscale: verifica importi, riduzioni e deducibilità con il tuo commercialista."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumo de trabalho gerado pelo Renting com os dados informados. Não é consultoria fiscal: confira valores, reduções e dedutibilidade com seu contador."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملخص عمل أنشأه Renting من بياناتك. ليس استشارة ضريبية: راجع المبالغ والتخفيضات وقابلية الخصم مع مستشارك الضريبي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डेटा से Renting द्वारा बनाया गया कार्य-सारांश। यह कर सलाह नहीं है: राशियाँ, छूट और कटौती नियम अपने कर सलाहकार से जाँचें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Renting 根据你录入的数据生成的工作汇总,不构成税务建议。金额、减免及可抵扣规则请与你的税务顾问核实。"
          }
        }
      }
    },
