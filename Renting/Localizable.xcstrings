    "rule.utilityIncrease.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A utility bill well above the average of the previous ones. Record real bills to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una factura de suministros muy por encima de la media de las anteriores. Anota las facturas reales para usarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Rechnung liegt deutlich über dem Durchschnitt der vorherigen. Erfasse die echten Rechnungen, um das zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une facture bien au-dessus de la moyenne des précédentes. Saisissez les vraies factures pour l'utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bolletta ben al di sopra della media delle precedenti. Registra le bollette reali per usarla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma fatura bem acima da média das anteriores. Registe as faturas reais para a usar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فاتورة أعلى بكثير من متوسط الفواتير السابقة. سجّل الفواتير الفعلية لتستفيد منها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बिल पिछले बिलों के औसत से काफ़ी ऊपर है। इसका उपयोग करने के लिए असली बिल दर्ज करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某张账单明显高于此前账单的平均值。请录入真实账单后才能使用。"
          }
        }
      }
    },
    "rule.suppliesGap": {
      "extractionState": "manual",
      "localizations": {
