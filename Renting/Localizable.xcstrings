    "kind.traditional.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole home, let as the tenant's permanent residence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vivienda completa, como residencia habitual del inquilino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ganze Wohnung als Hauptwohnsitz des Mieters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le logement entier, comme résidence principale du locataire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intero immobile, come residenza abituale dell'inquilino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O imóvel inteiro, como residência habitual do inquilino."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العقار كاملًا كمسكن دائم للمستأجر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा घर, किरायेदार के स्थायी निवास के रूप में।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整套出租,作为租客的常住住所。"
          }
        }
      }
    },
    "kind.rooms.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each room is let separately, with its own tenant and rent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada habitación se alquila por separado, con su inquilino y su renta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Zimmer wird einzeln vermietet, mit eigenem Mieter und eigener Miete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque chambre est louée séparément, avec son locataire et son loyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni stanza si affitta separatamente, con il suo inquilino e il suo canone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada quarto é alugado separadamente, com o seu inquilino e a sua renda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُؤجَّر كل غرفة على حدة بمستأجرها وإيجارها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर कमरा अलग से किराये पर, अपने किरायेदार और किराये के साथ।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个房间单独出租,各有租客和租金。"
          }
        }
      }
    },
    "kind.seasonal.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole home for a limited stay (studies, work assignments…), not the tenant's permanent residence. In Spain it does not qualify for the rental income reduction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vivienda completa por una estancia limitada (estudios, trabajo temporal…), no como residencia habitual. No da derecho a la reducción del IRPF por alquiler de vivienda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganze Wohnung für einen befristeten Aufenthalt (Studium, Arbeitseinsatz…), nicht als Hauptwohnsitz. In Spanien gilt dafür keine Steuerermäßigung für Wohnraummiete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logement entier pour un séjour limité (études, mission…), pas comme résidence principale. En Espagne, il n'ouvre pas droit à la réduction d'impôt sur les loyers d'habitation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immobile intero per un soggiorno limitato (studio, lavoro temporaneo…), non come residenza abituale. In Spagna non dà diritto alla riduzione IRPF per affitto abitativo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imóvel inteiro para uma estadia limitada (estudos, trabalho temporário…), não como residência habitual. Em Espanha não dá direito à redução de IRPF por arrendamento habitacional."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العقار كاملًا لإقامة محدودة (دراسة، عمل مؤقت…) وليس كمسكن دائم. في إسبانيا لا يستفيد من تخفيض ضريبة الدخل على إيجار السكن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित अवधि के लिए पूरा घर (पढ़ाई, अस्थायी काम…), स्थायी निवास नहीं। स्पेन में इस पर आवासीय किराये की आयकर छूट नहीं मिलती।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整套短期出租(求学、外派工作等),不作为租客常住住所。在西班牙不适用住房租金所得税减免。"
          }
        }
      }
    },
    "tenant.expenses.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the tenant pays on top of the rent for electricity, water, internet… It does not count towards the manager's commission or the rent income in the fiscal report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que paga además del alquiler por luz, agua, internet… No cuenta para la comisión del gestor ni como ingreso por alquiler en el informe fiscal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was der Mieter zusätzlich zur Miete für Strom, Wasser, Internet… zahlt. Zählt weder für die Provision der Verwaltung noch als Mieteinnahme im Steuerbericht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que le locataire paie en plus du loyer pour l'électricité, l'eau, internet… Ne compte ni pour la commission du gestionnaire ni comme revenu locatif dans le rapport fiscal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto l'inquilino paga oltre al canone per luce, acqua, internet… Non conta per la commissione del gestore né come entrata da affitto nel report fiscale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o inquilino paga além da renda por luz, água, internet… Não conta para a comissão do gestor nem como receita de aluguel no relatório fiscal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يدفعه المستأجر فوق الإيجار للكهرباء والماء والإنترنت… لا يُحتسب في عمولة المدير ولا كدخل إيجار في التقرير الضريبي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किराये के ऊपर बिजली, पानी, इंटरनेट… के लिए किरायेदार जो देता है। यह प्रबंधक के कमीशन या कर रिपोर्ट में किराया आय में नहीं गिना जाता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "租客在租金之外支付的电费、水费、网费等。不计入管理人佣金,也不计入税务报告中的租金收入。"
          }
        }
      }
    },
