    "tenant.history.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each circle is a month: tap to tick or untick it, touch and hold to enter a partial amount."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada círculo es un mes: toca para marcarlo o desmarcarlo, mantén pulsado para anotar un importe parcial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Kreis ist ein Monat: Tippen hakt ab oder zurück, lang drücken erfasst einen Teilbetrag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque cercle est un mois : touchez pour cocher ou décocher, maintenez pour saisir un montant partiel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni cerchio è un mese: tocca per spuntarlo o toglierlo, tieni premuto per un importo parziale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada círculo é um mês: toque para marcar ou desmarcar, mantenha premido para um valor parcial."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل دائرة شهر: اضغط لتحديدها أو إلغائها، واضغط مطولًا لإدخال مبلغ جزئي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर वृत्त एक महीना है: टिक करने या हटाने के लिए टैप करें, आंशिक राशि के लिए दबाकर रखें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个圆圈代表一个月:轻点勾选或取消,长按可录入部分金额。"
          }
        }
      }
    },
