    "letter.body2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new rent will be due from %@: not before the contract anniversary and, in any case, from the month after this written notification. It will be paid by the same means as until now. Utilities and other concepts are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nueva renta será exigible a partir de %@: no antes del aniversario del contrato y, en todo caso, desde el mes siguiente a esta notificación por escrito. Se abonará por los mismos medios que hasta ahora. Los suministros y demás conceptos no se ven afectados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Miete ist ab %@ fällig: nicht vor dem Vertragsjubiläum und in jedem Fall ab dem Monat nach dieser schriftlichen Mitteilung. Sie wird wie bisher gezahlt. Nebenkosten und übrige Positionen bleiben unberührt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau loyer sera exigible à partir de %@ : pas avant l'anniversaire du contrat et, en tout état de cause, à compter du mois suivant la présente notification écrite. Il sera payé par les mêmes moyens qu'auparavant. Les charges et autres postes ne sont pas affectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nuovo canone sarà dovuto a partire da %@: non prima dell'anniversario del contratto e, in ogni caso, dal mese successivo alla presente comunicazione scritta. Sarà versato con gli stessi mezzi di sempre. Utenze e altre voci non sono interessate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova renda será exigível a partir de %@: nunca antes do aniversário do contrato e, em qualquer caso, a partir do mês seguinte a esta notificação por escrito. Será paga pelos mesmos meios. Os consumos e demais conceitos não são afetados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستحق الإيجار الجديد اعتبارًا من %@: ليس قبل ذكرى العقد، وفي كل الأحوال من الشهر التالي لهذا الإخطار الكتابي. ويُسدَّد بالوسائل نفسها المعتمدة حتى الآن. لا تتأثر المرافق وسائر البنود."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया किराया %@ से देय होगा: अनुबंध की वर्षगाँठ से पहले नहीं और, हर स्थिति में, इस लिखित सूचना के अगले माह से। यह पहले की तरह ही चुकाया जाएगा। उपयोगिताएँ और अन्य मदें प्रभावित नहीं होंगी।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新租金自 %@ 起生效:不早于合同周年日,且无论如何自本书面通知后的下一个月起。支付方式不变。水电杂费及其他项目不受影响。"
          }
        }
      }
    },
    "letter.body3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you wish, I can provide the INE certificate for the index applied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo desea, puedo facilitarle la certificación del INE correspondiente al índice aplicado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Wunsch stelle ich Ihnen die INE-Bescheinigung zum angewandten Index zur Verfügung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous le souhaitez, je peux vous fournir le certificat de l'INE correspondant à l'indice appliqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo desidera, posso fornirLe il certificato dell'INE relativo all'indice applicato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desejar, posso facultar-lhe a certidão do INE relativa ao índice aplicado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن رغبتم، يمكنني تزويدكم بشهادة INE الخاصة بالمؤشر المطبَّق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप चाहें, तो मैं लागू सूचकांक का INE प्रमाणपत्र उपलब्ध करा सकता/सकती हूँ।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如您需要,我可提供所用指数对应的 INE 证明。"
          }
        }
      }
    },
