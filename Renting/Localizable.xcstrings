    "deposit.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The legal fianza for homes is one month's rent. Anything above it goes as an additional guarantee (maximum two months)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fianza legal en vivienda es una mensualidad. Lo que supere eso anótalo como garantía adicional (máximo dos mensualidades)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesetzliche Kaution bei Wohnraum ist eine Monatsmiete. Alles darüber gehört als zusätzliche Sicherheit erfasst (höchstens zwei Monate)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caution légale d'un logement est d'un mois de loyer. Le surplus se note comme garantie additionnelle (deux mois maximum)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cauzione legale per le abitazioni è di una mensilità. L'eccedenza va indicata come garanzia aggiuntiva (massimo due mensilità)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiança legal em habitação é uma renda mensal. O que exceder anote como garantia adicional (máximo duas rendas)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الضمان القانوني للسكن هو إيجار شهر واحد. ما زاد عنه سجّله كضمان إضافي (حدّه شهران)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवास की कानूनी जमानत एक माह का किराया है। उससे ऊपर की राशि अतिरिक्त गारंटी में दर्ज करें (अधिकतम दो माह)।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "住房的法定押金为一个月租金,超出部分请记为额外担保(最多两个月)。"
          }
        }
      }
    },
