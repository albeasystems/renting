          }
        }
      }
    },
    "data.recovered.message %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app started empty so nothing is overwritten. The unreadable file was kept as “%@” in the app's storage; if you use iCloud sync, your data will come back from there. Contact support before deleting the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app ha arrancado vacía para no sobrescribir nada. El archivo ilegible se ha conservado como «%@» en el almacenamiento de la app; si usas la sincronización con iCloud, tus datos volverán desde ahí. Contacta con soporte antes de borrar la app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wurde leer gestartet, damit nichts überschrieben wird. Die unlesbare Datei wurde als „%@“ im App-Speicher aufbewahrt; mit iCloud-Synchronisierung kommen deine Daten von dort zurück. Wende dich an den Support, bevor du die App löschst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app a démarré vide pour ne rien écraser. Le fichier illisible a été conservé sous « %@ » dans le stockage de l'app ; avec la synchronisation iCloud, vos données reviendront de là. Contactez l'assistance avant de supprimer l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app è partita vuota per non sovrascrivere nulla. Il file illeggibile è stato conservato come «%@» nell'archivio dell'app; con la sincronizzazione iCloud i tuoi dati torneranno da lì. Contatta l'assistenza prima di eliminare l'app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A app iniciou vazia para não sobrescrever nada. O ficheiro ilegível foi guardado como «%@» no armazenamento da app; com a sincronização iCloud, os seus dados voltarão daí. Contacte o suporte antes de apagar a app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأ التطبيق فارغًا كي لا يُستبدل شيء. حُفظ الملف غير المقروء باسم «%@» في مساحة التطبيق؛ وإن كنت تستخدم مزامنة iCloud فستعود بياناتك منها. تواصل مع الدعم قبل حذف التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप खाली शुरू हुआ ताकि कुछ अधिलेखित न हो। अपठनीय फ़ाइल ऐप के संग्रह में «%@» नाम से रखी गई है; iCloud सिंक है तो आपका डेटा वहीं से लौट आएगा। ऐप हटाने से पहले सहायता से संपर्क करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用以空数据启动,以免覆盖任何内容。无法读取的文件已保存为“%@”(位于应用存储中);如已开启 iCloud 同步,数据将从云端恢复。删除应用前请先联系支持。"
          }
        }
      }
    },
    "data.save_failed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last change could not be saved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar tu último cambio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzte Änderung konnte nicht gespeichert werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dernière modification n'a pas pu être enregistrée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l'ultima modifica"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a sua última alteração"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ آخر تغيير"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका अंतिम बदलाव सहेजा नहीं जा सका"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存你的最近更改"
          }
        }
      }
    },
    "data.save_failed.message %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change is only in memory: free some space on the device and edit anything again to retry. Detail: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio solo está en memoria: libera espacio en el dispositivo y vuelve a editar cualquier cosa para reintentarlo. Detalle: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung liegt nur im Speicher: Schaffe Platz auf dem Gerät und bearbeite etwas erneut, um es noch einmal zu versuchen. Detail: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification n'est qu'en mémoire : libérez de l'espace sur l'appareil et modifiez à nouveau quelque chose pour réessayer. Détail : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica è solo in memoria: libera spazio sul dispositivo e modifica di nuovo qualcosa per riprovare. Dettaglio: %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração está só em memória: liberte espaço no dispositivo e edite novamente qualquer coisa para tentar de novo. Detalhe: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التغيير موجود في الذاكرة فقط: حرّر مساحة على الجهاز وعدّل أي شيء مجددًا لإعادة المحاولة. التفاصيل: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव केवल मेमोरी में है: डिवाइस पर जगह खाली करें और दोबारा कुछ संपादित करें। विवरण: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改仅在内存中:请释放设备空间并再次编辑任意内容以重试。详情:%@"
          }
        }
      }
    },
    "upd.stale %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reference values are %lld days old and are not suggested: check the latest IRAV and the current rules before notifying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores de referencia tienen %lld días y no se sugieren: consulta el último IRAV y la normativa vigente antes de notificar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Referenzwerte sind %lld Tage alt und werden nicht vorgeschlagen: Prüfe den aktuellen IRAV und die geltenden Regeln, bevor du mitteilst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs de référence datent de %lld jours et ne sont pas suggérées : vérifiez le dernier IRAV et les règles en vigueur avant de notifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori di riferimento hanno %lld giorni e non vengono suggeriti: controlla l'ultimo IRAV e le norme vigenti prima di comunicare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores de referência têm %lld dias e não são sugeridos: consulte o último IRAV e as normas em vigor antes de notificar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمر القيم المرجعية %lld يومًا ولا تُقترح: راجع آخر IRAV والأنظمة السارية قبل الإخطار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदर्भ मान %lld दिन पुराने हैं और सुझाए नहीं जाते: सूचना देने से पहले नवीनतम IRAV और वर्तमान नियम जाँचें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考值已有 %lld 天,不再建议使用:通知前请核对最新 IRAV 和现行规则。"
          }
        }
      }
    },
