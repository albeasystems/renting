          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले माह के बिल उससे अधिक हैं जो किरायेदारों ने उपयोगिताओं के लिए दिया।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上月账单超过租客支付的水电杂费。"
          }
        }
      }
    },
