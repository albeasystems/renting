    "upd.no_clause": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No update clause: by law the rent cannot be updated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cláusula de actualización: por ley no se puede actualizar la renta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Anpassungsklausel: gesetzlich ist keine Mietanpassung möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de clause de révision : la loi interdit toute révision du loyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna clausola di adeguamento: per legge il canone non può essere adeguato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cláusula de atualização: por lei a renda não pode ser atualizada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد بند تحديث: لا يجوز قانونًا تحديث الإيجار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अद्यतन खंड नहीं: कानूनन किराया बढ़ाया नहीं जा सकता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无调整条款:依法不得调整租金。"
          }
        }
      }
    },
