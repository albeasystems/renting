    "settings.erase.message_cloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homes, tenants, payments and expenses will be deleted here, in your iCloud and on all your synced devices. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán viviendas, inquilinos, cobros y gastos aquí, en tu iCloud y en todos tus dispositivos sincronizados. No se puede deshacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohnungen, Mieter, Zahlungen und Ausgaben werden hier, in deinem iCloud und auf allen synchronisierten Geräten gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les logements, locataires, paiements et dépenses seront supprimés ici, dans votre iCloud et sur tous vos appareils synchronisés. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immobili, inquilini, pagamenti e spese verranno eliminati qui, nel tuo iCloud e su tutti i dispositivi sincronizzati. Non si può annullare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imóveis, inquilinos, pagamentos e despesas serão eliminados aqui, no seu iCloud e em todos os dispositivos sincronizados. Não é possível desfazer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف العقارات والمستأجرون والدفعات والمصروفات هنا وفي iCloud الخاص بك وعلى جميع أجهزتك المتزامنة. لا يمكن التراجع عن ذلك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवास, किरायेदार, भुगतान और खर्च यहाँ, आपके iCloud में और आपके सभी सिंक डिवाइस पर हटा दिए जाएँगे। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房产、租客、收款和支出将在此处、你的 iCloud 以及所有已同步设备上被删除。此操作无法撤销。"
          }
        }
      }
    },
