    "mgmt.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated each month on the rent collected, never on utilities. Tap to change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se calcula cada mes sobre el alquiler cobrado, nunca sobre los suministros. Toca para cambiarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird jeden Monat auf die eingegangene Miete berechnet, nie auf Nebenkosten. Tippen zum Ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculée chaque mois sur le loyer encaissé, jamais sur les charges. Touchez pour la modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolata ogni mese sul canone incassato, mai sulle utenze. Tocca per modificarla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculada todos os meses sobre a renda recebida, nunca sobre os consumos. Toque para alterar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب كل شهر على الإيجار المحصَّل، وليس على المرافق أبدًا. اضغط لتغييرها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर महीने वसूले गए किराये पर गणना, उपयोगिताओं पर कभी नहीं। बदलने के लिए टैप करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月按已收租金计算,不含水电杂费。轻点可修改。"
          }
        }
      }
    },
