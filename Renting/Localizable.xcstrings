    "cloud.needs_plan.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is part of the Renting Cloud subscription. Without it everything keeps working on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud forma parte de la suscripción Renting Cloud. Sin ella todo sigue funcionando en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Synchronisierung gehört zum Abo Renting Cloud. Ohne sie funktioniert auf diesem Gerät weiter alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud fait partie de l'abonnement Renting Cloud. Sans elle, tout continue de fonctionner sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione iCloud fa parte dell'abbonamento Renting Cloud. Senza, tutto continua a funzionare su questo dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização com iCloud faz parte da subscrição Renting Cloud. Sem ela, tudo continua a funcionar neste dispositivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة iCloud جزء من اشتراك Renting Cloud. وبدونها يستمر كل شيء بالعمل على هذا الجهاز."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud सिंक Renting Cloud सदस्यता का हिस्सा है। इसके बिना इस डिवाइस पर सब कुछ पहले की तरह चलता रहेगा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步属于 Renting Cloud 订阅。没有订阅时,本设备上的一切仍可正常使用。"
          }
        }
      }
    },
