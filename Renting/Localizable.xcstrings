    "kpi.eq.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not the tax result: the Tax tab applies deductible expenses, depreciation, the reduction of each contract and the days a home was empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es el resultado fiscal: la pestaña Fiscal aplica gastos deducibles, amortización, la reducción de cada contrato y los días en que la vivienda estuvo vacía."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist nicht das steuerliche Ergebnis: Der Reiter „Steuern“ berücksichtigt abzugsfähige Ausgaben, Abschreibung, die Minderung jedes Vertrags und die Leerstandstage einer Wohnung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas le résultat fiscal : l'onglet Fiscal applique les dépenses déductibles, l'amortissement, la réduction de chaque contrat et les jours où un logement est resté vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è il risultato fiscale: la scheda Fisco applica le spese deducibili, l'ammortamento, la riduzione di ogni contratto e i giorni in cui un immobile è rimasto sfitto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é o resultado fiscal: o separador Fiscal aplica as despesas dedutíveis, a amortização, a redução de cada contrato e os dias em que um imóvel esteve vazio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه ليست النتيجة الضريبية: يطبّق تبويب الضرائب المصروفات القابلة للخصم والإهلاك وتخفيض كل عقد وأيام بقاء العقار شاغرًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कर-परिणाम नहीं है: कर टैब कटौती-योग्य खर्च, मूल्यह्रास, प्रत्येक अनुबंध की कटौती और आवास के खाली रहने के दिन लागू करता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是税务结果:「税务」标签页会计入可抵扣支出、折旧、每份合同的减免,以及房产空置的天数。"
          }
        }
      }
    },
