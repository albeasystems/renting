    "dash.income.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collected = rent + utilities charged to tenants. Quarters start on 1 January: Q1 Jan–Mar, Q2 Apr–Jun, Q3 Jul–Sep, Q4 Oct–Dec."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobrado = alquiler + suministros repercutidos. Los trimestres empiezan el 1 de enero: T1 ene–mar, T2 abr–jun, T3 jul–sep, T4 oct–dic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingenommen = Miete + umgelegte Nebenkosten. Quartale beginnen am 1. Januar: Q1 Jan–Mär, Q2 Apr–Jun, Q3 Jul–Sep, Q4 Okt–Dez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaissé = loyer + charges refacturées. Les trimestres commencent le 1er janvier : T1 janv.–mars, T2 avr.–juin, T3 juil.–sept., T4 oct.–déc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incassato = canone + utenze addebitate. I trimestri iniziano il 1° gennaio: T1 gen–mar, T2 apr–giu, T3 lug–set, T4 ott–dic."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recebido = renda + consumos repassados. Os trimestres começam a 1 de janeiro: T1 jan–mar, T2 abr–jun, T3 jul–set, T4 out–dez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحصَّل = الإيجار + المرافق المحمّلة. تبدأ الأرباع في 1 يناير: ر1 يناير–مارس، ر2 أبريل–يونيو، ر3 يوليو–سبتمبر، ر4 أكتوبر–ديسمبر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वसूली = किराया + किरायेदारों से ली गई उपयोगिताएँ। तिमाहियाँ 1 जनवरी से शुरू: ति1 जन–मार्च, ति2 अप्रैल–जून, ति3 जुलाई–सितंबर, ति4 अक्टूबर–दिसंबर।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已收 = 租金 + 向租客收取的水电杂费。季度从 1 月 1 日起算:Q1 1–3 月,Q2 4–6 月,Q3 7–9 月,Q4 10–12 月。"
          }
        }
      }
    },
