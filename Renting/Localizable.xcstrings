    "upd.keep.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records that you decided not to raise it and stops the reminder. You can still update later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota que decidiste no subirla y detiene el aviso. Podrás actualizarla más adelante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält fest, dass du nicht erhöhst, und beendet die Erinnerung. Eine spätere Anpassung bleibt möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre que vous ne l'augmentez pas et arrête le rappel. Vous pourrez encore la réviser plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra che hai deciso di non aumentarlo e ferma il promemoria. Potrai adeguarlo anche più avanti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista que decidiu não aumentar e pára o aviso. Poderá atualizar mais tarde."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل أنك قررت عدم الرفع ويوقف التذكير. يمكنك التحديث لاحقًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज करता है कि आपने बढ़ाना नहीं चुना और अनुस्मारक रोकता है। आप बाद में भी अद्यतन कर सकते हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你决定不涨租并停止提醒,之后仍可再调整。"
          }
        }
      }
    },
