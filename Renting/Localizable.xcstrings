    "fiscal.depreciation.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yearly depreciation of the construction value without the land (3 %), in proportion to the days the home was let."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amortización anual del valor de construcción sin el suelo (3 %), en proporción a los días alquilada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jährliche Abschreibung des Gebäudewerts ohne Grundstück (3 %), anteilig nach den vermieteten Tagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amortissement annuel de la valeur de construction hors terrain (3 %), au prorata des jours loués."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ammortamento annuo del valore di costruzione senza il terreno (3 %), in proporzione ai giorni affittati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Amortização anual do valor de construção sem o terreno (3 %), em proporção aos dias arrendado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إهلاك سنوي لقيمة البناء دون الأرض (3٪) بنسبة الأيام المؤجَّرة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भूमि को छोड़कर निर्माण मूल्य का वार्षिक मूल्यह्रास (3 %), किराये पर दिए गए दिनों के अनुपात में।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按建筑价值(不含土地)每年折旧(3%),按出租天数比例计算。"
          }
        }
      }
    },
