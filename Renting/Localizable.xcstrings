    "fiscal.utilities_warning %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You marked utilities as deductible: the tax office then also counts the %@ tenants paid for them as income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has marcado suministros como deducibles: Hacienda considera entonces ingreso los %@ que te pagaron los inquilinos por ellos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Nebenkosten als absetzbar markiert: Das Finanzamt zählt dann auch die %@, die Mieter dafür gezahlt haben, als Einnahme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez marqué des charges comme déductibles : le fisc compte alors aussi comme revenu les %@ payés par les locataires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai segnato le utenze come deducibili: il fisco considera allora entrata anche i %@ pagati dagli inquilini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcou consumos como dedutíveis: o fisco considera então receita os %@ pagos pelos inquilinos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حددت المرافق كقابلة للخصم: تعتبر مصلحة الضرائب حينها مبلغ %@ الذي دفعه المستأجرون دخلًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने उपयोगिताओं को कटौती योग्य चिह्नित किया: तब कर विभाग किरायेदारों से मिले %@ को भी आय मानता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已将水电杂费标为可抵扣:税务机关会将租客为此支付的 %@ 也计为收入。"
          }
        }
      }
    },
