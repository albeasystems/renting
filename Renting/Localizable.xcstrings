    "rule.rentUpdate.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contract anniversary is near and the rent has not been updated or kept yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acerca el aniversario del contrato y la renta no se ha actualizado ni mantenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vertragsjahrestag naht und die Miete wurde weder angepasst noch beibehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anniversaire du contrat approche et le loyer n'a été ni révisé ni maintenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anniversario del contratto si avvicina e il canone non è stato né adeguato né mantenuto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O aniversário do contrato aproxima-se e a renda não foi atualizada nem mantida."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقترب ذكرى العقد ولم يُحدَّث الإيجار ولم يُبقَ كما هو بعد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुबंध की वर्षगाँठ नज़दीक है और किराया न अद्यतन हुआ है, न यथावत रखा गया है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合同周年日临近,租金既未调整也未决定保持不变。"
          }
        }
      }
    },
