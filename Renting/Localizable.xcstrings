    "receipt.legal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipt under article 17.4 of the Spanish Urban Leases Act (LAU): each concept is listed separately. Generated with Renting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibo conforme al artículo 17.4 de la Ley de Arrendamientos Urbanos: cada concepto figura por separado. Generado con Renting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittung gemäß Art. 17.4 des spanischen Mietgesetzes (LAU): jede Position einzeln aufgeführt. Erstellt mit Renting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittance conforme à l'article 17.4 de la loi espagnole sur les baux urbains (LAU) : chaque poste est détaillé. Générée avec Renting."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevuta ai sensi dell'art. 17.4 della legge spagnola sulle locazioni urbane (LAU): ogni voce è indicata separatamente. Generata con Renting."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibo nos termos do artigo 17.4 da lei espanhola de arrendamentos urbanos (LAU): cada conceito figura em separado. Gerado com Renting."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيصال وفق المادة 17.4 من قانون الإيجارات الحضرية الإسباني (LAU): يُذكر كل بند على حدة. أُنشئ بواسطة Renting."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पेन के शहरी पट्टा अधिनियम (LAU) की धारा 17.4 के अनुसार रसीद: हर मद अलग दर्शाई गई है। Renting से बनाई गई।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依据西班牙《城市租赁法》(LAU)第 17.4 条出具的收据:各项费用分别列示。由 Renting 生成。"
          }
        }
      }
    },
