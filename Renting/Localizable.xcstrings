    "kpi.mix.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No expenses this month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin gastos este mes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Ausgaben in diesem Monat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune dépense ce mois-ci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna spesa questo mese"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem despesas este mês"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مصروفات هذا الشهر"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस माह कोई खर्च नहीं"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月无支出"
          }
        }
      }
    },
    "kpi.mix.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expenses of the month by category. A few categories usually take most of it: knowing which ones tells you where saving is possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gastos del mes por categoría. Unas pocas categorías suelen llevarse la mayor parte: saber cuáles te dice dónde puedes ahorrar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgaben des Monats nach Kategorie. Wenige Kategorien machen meist den Großteil aus: Wenn du weißt, welche, siehst du, wo du sparen kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses du mois par catégorie. Quelques catégories en représentent généralement l'essentiel : savoir lesquelles vous indique où économiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese del mese per categoria. Poche categorie di solito pesano per la maggior parte: sapere quali ti dice dove puoi risparmiare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As despesas do mês por categoria. Algumas categorias costumam levar a maior parte: saber quais indica onde pode poupar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصروفات الشهر حسب الفئة. تستحوذ عادةً بضع فئات على معظمها؛ ومعرفتها تدلّك على مواضع التوفير."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माह के खर्च श्रेणी के अनुसार। आमतौर पर कुछ ही श्रेणियाँ अधिकांश हिस्सा लेती हैं: उन्हें जानने से पता चलता है कि बचत कहाँ संभव है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按类别列出的当月支出。通常少数几类占了大部分:知道是哪几类,就知道哪里能省。"
          }
        }
      }
    },
    "kpi.mix.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sum of every expense that falls due in the month, including the manager's commission. Fixed costs (IBI, community, insurance) are hard to cut; variable ones (utilities, repairs, cleaning) are where you can act: compare suppliers, record real bills and watch the alert for big increases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma de todos los gastos que vencen en el mes, incluida la comisión del gestor. Los fijos (IBI, comunidad, seguro) son difíciles de recortar; los variables (suministros, reparaciones, limpieza) son donde puedes actuar: compara proveedores, anota las facturas reales y vigila la alerta de subidas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Summe aller im Monat fälligen Ausgaben, einschließlich der Verwalterprovision. Fixkosten (IBI, Hausgeld, Versicherung) lassen sich kaum senken; bei variablen (Nebenkosten, Reparaturen, Reinigung) kannst du ansetzen: Anbieter vergleichen, echte Rechnungen erfassen und den Hinweis auf starke Anstiege beachten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somme de toutes les dépenses échues dans le mois, y compris la commission du gestionnaire. Les coûts fixes (IBI, copropriété, assurance) sont difficiles à réduire ; c'est sur les variables (charges, réparations, ménage) que vous pouvez agir : comparez les fournisseurs, saisissez les vraies factures et surveillez l'alerte de fortes hausses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Somma di tutte le spese in scadenza nel mese, inclusa la commissione del gestore. I costi fissi (IBI, condominio, assicurazione) sono difficili da tagliare; sui variabili (utenze, riparazioni, pulizie) puoi intervenire: confronta i fornitori, registra le bollette reali e tieni d'occhio l'avviso sui rincari forti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma de todas as despesas que vencem no mês, incluindo a comissão do gestor. Os custos fixos (IBI, condomínio, seguro) são difíceis de cortar; nos variáveis (consumos, reparações, limpeza) pode agir: compare fornecedores, registe as faturas reais e acompanhe o alerta de subidas fortes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموع كل المصروفات المستحقة في الشهر، بما فيها عمولة المدير. يصعب تقليص التكاليف الثابتة (IBI، رسوم المجتمع، التأمين)؛ أما المتغيرة (المرافق، الإصلاحات، التنظيف) فهي ما يمكنك التحكم فيه: قارن الموردين، وسجّل الفواتير الفعلية، وتابع تنبيه الزيادات الكبيرة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माह में देय सभी खर्चों का योग, प्रबंधक का कमीशन सहित। स्थिर लागतें (IBI, सोसायटी शुल्क, बीमा) घटाना कठिन है; परिवर्तनीय (उपयोगिताएँ, मरम्मत, सफ़ाई) में आप कुछ कर सकते हैं: आपूर्तिकर्ताओं की तुलना करें, असली बिल दर्ज करें और बड़ी वृद्धि वाले अलर्ट पर नज़र रखें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当月到期的所有支出之和,包括管理人佣金。固定成本(IBI、物业费、保险)很难削减;可变成本(水电杂费、维修、清洁)才是你能下手的地方:比较供应商、录入真实账单,并留意大幅上涨提醒。"
          }
        }
      }
    },
    "kpi.margin.title": {
      "extractionState": "manual",
