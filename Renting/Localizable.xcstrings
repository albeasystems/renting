    "fiscal.adv.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depreciation, reductions per contract, income imputed to empty days and choosing which expenses are deductible are included in the subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La amortización, las reducciones por contrato, la imputación de rentas por días vacíos y elegir qué gastos son deducibles van incluidas en la suscripción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abschreibung, Ermäßigungen je Vertrag, Einkünfte für Leerstandstage und die Wahl der absetzbaren Ausgaben sind im Abo enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'amortissement, les réductions par bail, les revenus imputés aux jours vacants et le choix des dépenses déductibles sont inclus dans l'abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ammortamento, riduzioni per contratto, redditi imputati ai giorni sfitti e la scelta delle spese deducibili sono inclusi nell'abbonamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A depreciação, as reduções por contrato, a imputação de rendimentos por dias vazios e a escolha das despesas dedutíveis estão incluídas na subscrição."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإهلاك والتخفيضات لكل عقد والدخل المُحتسب لأيام الشغور واختيار المصروفات القابلة للخصم مشمولة في الاشتراك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल्यह्रास, प्रति अनुबंध छूट, खाली दिनों की आरोपित आय और कटौती-योग्य खर्च चुनने की सुविधा सदस्यता में शामिल हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折旧、按合同的减免、空置天数的推定收入,以及选择哪些费用可抵扣,均包含在订阅中。"
          }
        }
      }
    },
