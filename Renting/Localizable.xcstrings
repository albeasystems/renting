    "rule.depositFiling.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fianza is not marked as deposited with the authority within the days set after move-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fianza no está marcada como depositada en el organismo dentro de los días fijados desde la entrada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kaution (fianza) ist innerhalb der nach dem Einzug festgelegten Tage nicht als bei der Behörde hinterlegt markiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caution (fianza) n'est pas marquée comme déposée auprès de l'organisme dans les jours fixés après l'entrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cauzione (fianza) non è segnata come depositata presso l'ente entro i giorni stabiliti dall'ingresso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiança não está marcada como depositada no organismo dentro dos dias definidos após a entrada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحدَّد الضمان (fianza) كمودَع لدى الجهة المختصة خلال الأيام المحددة بعد الدخول."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्धारित दिनों में जमानत (fianza) को प्राधिकरण में जमा के रूप में चिह्नित नहीं किया गया है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "押金(fianza)未在入住后设定的天数内标记为已存放到主管机构。"
          }
        }
      }
    },
