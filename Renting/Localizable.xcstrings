    "form.rooms.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each room has its own rent and utilities contribution. They are where the next tenant of that room starts, and every tenant keeps the price they signed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada habitación tiene su propio alquiler y su aportación de gastos. Son el punto de partida del próximo inquilino de esa habitación, y cada inquilino conserva el precio que firmó."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Zimmer hat seine eigene Miete und seinen eigenen Nebenkostenbeitrag. Sie sind der Ausgangspunkt für den nächsten Mieter des Zimmers; jeder Mieter behält den Preis, den er unterschrieben hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque chambre a son propre loyer et sa propre participation aux charges. Ce sont le point de départ du prochain locataire de la chambre, et chaque locataire garde le prix qu'il a signé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni stanza ha il proprio canone e il proprio contributo alle spese. Sono il punto di partenza del prossimo inquilino della stanza e ogni inquilino conserva il prezzo che ha firmato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada quarto tem a sua própria renda e a sua própria contribuição para despesas. São o ponto de partida do próximo inquilino do quarto, e cada inquilino mantém o preço que assinou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكل غرفة إيجارها الخاص ومساهمتها الخاصة في المصروفات. وهي نقطة البداية للمستأجر التالي في الغرفة، ويحتفظ كل مستأجر بالسعر الذي وقّع عليه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर कमरे का अपना किराया और खर्चों में अपना योगदान होता है। ये उस कमरे के अगले किरायेदार की शुरुआत हैं, और हर किरायेदार वही कीमत रखता है जिस पर उसने हस्ताक्षर किए।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个房间都有各自的租金和费用分摊。它们是该房间下一位租客的起点,而每位租客保留自己签约时的价格。"
          }
        }
      }
    },
    "unit.price_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room's price is only where the next tenant starts. Each tenant keeps their own rent and utilities, so you can raise or lower it when one leaves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio de la habitación es solo el punto de partida del siguiente inquilino. Cada inquilino conserva su propio alquiler y gastos, así que puedes subirlo o bajarlo cuando uno se va."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zimmerpreis ist nur der Ausgangspunkt für den nächsten Mieter. Jeder Mieter behält seine eigene Miete und Nebenkosten, du kannst den Preis also anpassen, wenn einer auszieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix de la chambre n'est que le point de départ du prochain locataire. Chaque locataire garde son propre loyer et ses charges : vous pouvez donc le monter ou le baisser quand l'un d'eux part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prezzo della stanza è solo il punto di partenza del prossimo inquilino. Ogni inquilino mantiene il proprio canone e le proprie utenze, quindi puoi alzarlo o abbassarlo quando uno se ne va."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O preço do quarto é apenas o ponto de partida do próximo inquilino. Cada inquilino mantém a sua própria renda e despesas, por isso pode subi-lo ou baixá-lo quando um sai."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سعر الغرفة هو مجرد نقطة البداية للمستأجر التالي. يحتفظ كل مستأجر بإيجاره ومصروفاته، لذا يمكنك رفعه أو خفضه عندما يغادر أحدهم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमरे की कीमत अगले किरायेदार की सिर्फ़ शुरुआत है। हर किरायेदार अपना किराया और खर्च रखता है, इसलिए जब कोई जाए तो आप इसे बढ़ा या घटा सकते हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间价格只是下一位租客的起点。每位租客保留自己的租金和费用,因此有人搬走时你可以上调或下调。"
          }
        }
      }
    },
