    "settings.load_demo_real.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace your data with the sample portfolio as real data?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Reemplazar tus datos por la cartera de ejemplo como datos reales?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten durch das Beispielportfolio als echte Daten ersetzen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer vos données par le portefeuille d'exemple comme données réelles ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituire i tuoi dati con il portafoglio di esempio come dati reali?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir os seus dados pela carteira de exemplo como dados reais?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال بياناتك بمحفظة العينة كبيانات حقيقية؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने डेटा को नमूना पोर्टफ़ोलियो से असली डेटा के रूप में बदलें?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用示例资产组合替换你的数据,并作为真实数据?"
          }
        }
      }
    },
    "settings.load_demo_real.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current data will be replaced. Unlike the sample data, this one can sync with iCloud. Do it on ONE device only: the others should download it, or the portfolio will end up twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sustituirán tus datos actuales. A diferencia de los datos de ejemplo, estos sí se sincronizan con iCloud. Hazlo en UN solo dispositivo: los demás deben descargarlo, o la cartera quedará duplicada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine aktuellen Daten werden ersetzt. Anders als die Beispieldaten lassen sich diese mit iCloud synchronisieren. Mach das nur auf EINEM Gerät: Die anderen sollten es herunterladen, sonst ist das Portfolio doppelt vorhanden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données actuelles seront remplacées. Contrairement aux données d'exemple, celles-ci peuvent se synchroniser avec iCloud. Ne le faites que sur UN seul appareil : les autres doivent les télécharger, sinon le portefeuille sera en double."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati attuali verranno sostituiti. A differenza dei dati di esempio, questi si possono sincronizzare con iCloud. Fallo su UN solo dispositivo: gli altri devono scaricarli, altrimenti il portafoglio risulterà doppio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus dados atuais serão substituídos. Ao contrário dos dados de exemplo, estes podem sincronizar com o iCloud. Faça-o em APENAS um dispositivo: os outros devem descarregá-los, ou a carteira ficará duplicada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُستبدل بياناتك الحالية. وعلى عكس البيانات التجريبية، يمكن مزامنة هذه مع iCloud. افعل ذلك على جهاز واحد فقط: يجب أن تنزّلها الأجهزة الأخرى، وإلا ستتكرر المحفظة مرتين."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका मौजूदा डेटा बदल दिया जाएगा। नमूना डेटा के विपरीत, यह iCloud के साथ सिंक हो सकता है। इसे केवल एक डिवाइस पर करें: बाकी इसे डाउनलोड करें, वरना पोर्टफ़ोलियो दो बार हो जाएगा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你当前的数据将被替换。与示例数据不同,这些数据可与 iCloud 同步。请只在一台设备上执行:其他设备应下载它,否则资产组合会重复。"
          }
        }
      }
    },
    "settings.load_demo_real.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Testing only (development and TestFlight builds). Turn iCloud sync off first; turn it on after loading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para pruebas (compilaciones de desarrollo y TestFlight). Desactiva antes la sincronización con iCloud y actívala después de cargar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zum Testen (Entwicklungs- und TestFlight-Builds). Schalte zuerst die iCloud-Synchronisierung aus; aktiviere sie nach dem Laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les tests uniquement (versions de développement et TestFlight). Désactivez d'abord la synchronisation iCloud ; réactivez-la après le chargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per test (build di sviluppo e TestFlight). Disattiva prima la sincronizzazione iCloud; riattivala dopo il caricamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para testes (versões de desenvolvimento e TestFlight). Desative primeiro a sincronização com iCloud; ative-a após carregar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاختبار فقط (إصدارات التطوير وTestFlight). أوقف مزامنة iCloud أولًا ثم فعّلها بعد التحميل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल परीक्षण के लिए (डेवलपमेंट और TestFlight बिल्ड)। पहले iCloud सिंक बंद करें; लोड करने के बाद चालू करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供测试(开发版与 TestFlight 版本)。请先关闭 iCloud 同步,载入后再开启。"
          }
        }
      }
    },
    "data.recovered.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data could not be read"
          }
        },
        "es": {
