    "cloud.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. Your data stays on the devices where it is now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede deshacer. Tus datos se quedan en los dispositivos donde están ahora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen. Deine Daten bleiben auf den Geräten, auf denen sie jetzt sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Vos données restent sur les appareils où elles se trouvent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare. I tuoi dati restano sui dispositivi in cui si trovano ora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível desfazer. Os seus dados ficam nos dispositivos onde estão agora."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن ذلك. تبقى بياناتك على الأجهزة التي توجد عليها الآن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे पूर्ववत नहीं किया जा सकता। आपका डेटा उन्हीं डिवाइस पर रहेगा जहाँ वह अभी है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。你的数据仍保留在它目前所在的设备上。"
          }
        }
      }
    },
    "cloud.err.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
