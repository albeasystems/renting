    "rule.expectedRent.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows (and notifies on the day you choose) how much rent you still expect this month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra (y avisa el día que elijas) cuánto alquiler esperas todavía este mes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt (und meldet am gewählten Tag), wie viel Miete du in diesem Monat noch erwartest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique (et notifie le jour choisi) combien de loyer vous attendez encore ce mois-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra (e avvisa nel giorno scelto) quanto canone ti aspetti ancora questo mese."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra (e avisa no dia escolhido) quanta renda ainda espera este mês."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض (وينبّه في اليوم الذي تختاره) مقدار الإيجار الذي لا تزال تتوقعه هذا الشهر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस माह आप कितना किराया और उम्मीद करते हैं, यह दिखाता है (और चुने गए दिन सूचित करता है)।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示(并在你设定的日期通知)本月还应收多少租金。"
          }
        }
      }
    },
