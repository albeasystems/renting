    "exp.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a circle to mark that payment as done, or tap again to undo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un círculo para marcar el pago como hecho; vuelve a tocar para deshacerlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Kreis, um die Zahlung abzuhaken; erneut tippen macht es rückgängig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un cercle pour marquer le paiement comme fait ; touchez à nouveau pour annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un cerchio per segnare il pagamento come fatto; tocca di nuovo per annullare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num círculo para marcar o pagamento como feito; toque de novo para desfazer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على دائرة لتحديد الدفعة كمنجزة، واضغط مجددًا للتراجع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान पूरा चिह्नित करने के लिए वृत्त पर टैप करें; पूर्ववत करने के लिए फिर टैप करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点圆圈将该笔付款标为已付,再次轻点可撤销。"
          }
        }
      }
    },
