    "rule.suppliesGap.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bills of last month exceed what tenants paid for utilities."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las facturas del mes pasado superan lo que pagaron los inquilinos por suministros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rechnungen des Vormonats übersteigen, was Mieter für Nebenkosten gezahlt haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les factures du mois dernier dépassent ce que les locataires ont payé pour les charges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bollette del mese scorso superano quanto hanno pagato gli inquilini per le utenze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As faturas do mês passado excedem o que os inquilinos pagaram por consumos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
