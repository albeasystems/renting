    "pro.f.reports.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depreciation, reductions per contract, income imputed to empty days, the deductible expenses you choose and the PDF/CSV report for your tax advisor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amortización, reducciones por contrato, rentas imputadas por los días vacíos, los gastos deducibles que elijas y el informe PDF/CSV para tu gestor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abschreibung, Ermäßigungen je Vertrag, für Leerstandstage angesetzte Einkünfte, die abziehbaren Ausgaben deiner Wahl und der PDF-/CSV-Bericht für deinen Steuerberater."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amortissement, réductions par bail, revenus imputés aux jours vacants, les dépenses déductibles de votre choix et le rapport PDF/CSV pour votre conseiller fiscal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ammortamento, riduzioni per contratto, redditi imputati ai giorni sfitti, le spese deducibili che scegli e il rapporto PDF/CSV per il tuo commercialista."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depreciação, reduções por contrato, rendimentos imputados aos dias vazios, as despesas dedutíveis que escolher e o relatório PDF/CSV para o seu contabilista."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإهلاك، والتخفيضات لكل عقد، والدخل المُحتسب لأيام الشغور، والمصروفات القابلة للخصم التي تختارها، وتقرير PDF/CSV لمستشارك الضريبي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल्यह्रास, प्रति अनुबंध छूट, खाली दिनों की आरोपित आय, आपके चुने कटौती-योग्य खर्च और आपके कर सलाहकार के लिए PDF/CSV रिपोर्ट।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折旧、按合同的减免、空置天数的推定收入、由你选择的可抵扣费用,以及供税务顾问使用的 PDF/CSV 报告。"
          }
        }
      }
    },
