    "settings.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renting is a management aid, not legal or tax advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renting es una ayuda de gestión, no asesoramiento legal ni fiscal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Renting ist eine Verwaltungshilfe, keine Rechts- oder Steuerberatung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renting est une aide à la gestion, pas un conseil juridique ou fiscal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Renting è un aiuto alla gestione, non una consulenza legale o fiscale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Renting é uma ajuda de gestão, não consultoria jurídica ou fiscal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Renting أداة مساعدة للإدارة وليست استشارة قانونية أو ضريبية."
          }
        },
        "hi": {
