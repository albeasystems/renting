        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. The amount and date you recorded will be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Se perderán el importe y la fecha anotados."
