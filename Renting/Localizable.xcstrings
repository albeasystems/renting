          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud अभी उपलब्ध नहीं है। बाद में फिर कोशिश करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 暂时不可用,请稍后再试。"
          }
        }
      }
    },
    "cloud.err.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection. It will sync when you are back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Se sincronizará cuando vuelvas a tener red."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung. Es wird synchronisiert, sobald du wieder online bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion. La synchronisation se fera au retour en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione. Si sincronizzerà quando tornerai online."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ligação. Sincronizará quando voltar a estar online."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال. ستتم المزامنة عند عودتك إلى الإنترنت."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन नहीं है। ऑनलाइन लौटने पर सिंक हो जाएगा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无网络连接。恢复联网后将自动同步。"
          }
        }
      }
    },
