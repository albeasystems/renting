    "alerts.notifications.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications follow your alert rules: choose what to be told about, when and with how much notice in “Customize alerts”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones siguen tus reglas de alertas: elige de qué avisarte, cuándo y con cuánta antelación en «Personalizar alertas»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen folgen deinen Alarmregeln: Lege unter „Hinweise anpassen“ fest, worüber, wann und mit welchem Vorlauf du informiert wirst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications suivent vos règles d'alerte : choisissez de quoi être prévenu, quand et avec quel préavis dans « Personnaliser les alertes »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche seguono le tue regole di avviso: scegli di cosa essere avvisato, quando e con quanto anticipo in «Personalizza avvisi»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações seguem as suas regras de alerta: escolha do que ser avisado, quando e com que antecedência em «Personalizar alertas»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع الإشعارات قواعد التنبيه الخاصة بك: اختر ما تريد أن تُنبَّه إليه ومتى وبأي مهلة في «تخصيص التنبيهات»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ आपके अलर्ट नियमों का पालन करती हैं: «अलर्ट अनुकूलित करें» में चुनें कि किसकी, कब और कितने पहले सूचना चाहिए।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知遵循你的提醒规则:在“自定义提醒”中选择提醒内容、时间和提前量。"
          }
        }
      }
    },
