    "fiscal.current_year": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current year: expenses and imputed income are estimated up to December; income is what has been collected so far."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Año en curso: los gastos y las rentas imputadas se estiman hasta diciembre; los ingresos son los cobrados hasta hoy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufendes Jahr: Ausgaben und fiktive Einkünfte bis Dezember geschätzt; Einnahmen bis heute erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Année en cours : dépenses et revenus imputés estimés jusqu'à décembre ; les revenus sont ceux encaissés à ce jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anno in corso: spese e redditi imputati stimati fino a dicembre; le entrate sono quelle incassate finora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano em curso: despesas e rendimentos imputados estimados até dezembro; as receitas são as recebidas até hoje."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السنة الجارية: تُقدَّر المصروفات والدخل المُحتسب حتى ديسمبر؛ والإيرادات هي المحصَّلة حتى اليوم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू वर्ष: खर्च और आरोपित आय दिसंबर तक अनुमानित; आय अब तक वसूली गई है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本年度:支出和推定收入按至 12 月估算;收入为截至目前已收金额。"
          }
        }
      }
    },
