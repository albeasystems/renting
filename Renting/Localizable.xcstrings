    "rule.utilityIncrease": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Utility bill much higher"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subida fuerte de consumos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebenkostenrechnung deutlich höher"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facture de charges nettement plus élevée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolletta delle utenze molto più alta"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatura de consumos muito mais alta"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فاتورة مرافق أعلى بكثير"
          }
        },
        "hi": {
