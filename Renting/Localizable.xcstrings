    "plan.f.homes.text %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free plan includes up to %lld. With the subscription, as many as you manage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratis incluye hasta %lld. Con la suscripción, todas las que gestiones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kostenlose Plan umfasst bis zu %lld. Mit dem Abo so viele, wie du verwaltest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan gratuit en comprend jusqu'à %lld. Avec l'abonnement, autant que vous en gérez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano gratuito ne include fino a %lld. Con l'abbonamento, tutti quelli che gestisci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano gratuito inclui até %lld. Com a subscrição, todos os que gerir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشمل الخطة المجانية حتى %lld. ومع الاشتراك، بقدر ما تديره."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त प्लान में %lld तक शामिल हैं। सदस्यता के साथ, जितने आप संभालते हैं उतने।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费方案最多包含 %lld 处。订阅后,你管理多少就能添加多少。"
          }
        }
      }
    },
