    "letter.body1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarding the lease of the property at %1$@, which began on %2$@, and in accordance with article 18 of the Spanish Urban Leases Act (LAU) and the update clause of the contract, I hereby notify you that the monthly rent is updated by %3$@, %4$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En relación con el contrato de arrendamiento del inmueble sito en %1$@, con inicio el %2$@, y de conformidad con el artículo 18 de la Ley de Arrendamientos Urbanos y con la cláusula de actualización del contrato, le comunico que la renta mensual se actualiza en un %3$@, %4$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezüglich des Mietvertrags für das Objekt in %1$@, beginnend am %2$@, und gemäß Art. 18 des spanischen Mietgesetzes (LAU) sowie der Anpassungsklausel des Vertrags teile ich Ihnen mit, dass die Monatsmiete um %3$@ angepasst wird, %4$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concernant le bail du logement situé %1$@, ayant débuté le %2$@, et conformément à l'article 18 de la loi espagnole sur les baux urbains (LAU) et à la clause de révision du contrat, je vous notifie que le loyer mensuel est révisé de %3$@, %4$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In relazione al contratto di locazione dell'immobile sito in %1$@, iniziato il %2$@, e ai sensi dell'articolo 18 della legge spagnola sulle locazioni urbane (LAU) e della clausola di adeguamento del contratto, Le comunico che il canone mensile è adeguato del %3$@, %4$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Relativamente ao contrato de arrendamento do imóvel sito em %1$@, iniciado em %2$@, e nos termos do artigo 18 da lei espanhola dos arrendamentos urbanos (LAU) e da cláusula de atualização do contrato, comunico que a renda mensal é atualizada em %3$@, %4$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بخصوص عقد إيجار العقار الكائن في %1$@ والذي بدأ في %2$@، ووفقًا للمادة 18 من قانون الإيجارات الحضرية الإسباني (LAU) وبند التحديث في العقد، أُعلمكم بأن الإيجار الشهري يُحدَّث بنسبة %3$@، %4$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ में स्थित संपत्ति के, %2$@ से प्रारंभ, किराया अनुबंध के संबंध में, तथा स्पेन के शहरी पट्टा अधिनियम (LAU) के अनुच्छेद 18 और अनुबंध के अद्यतन खंड के अनुसार, मैं सूचित करता/करती हूँ कि मासिक किराया %3$@ बढ़ाया जा रहा है, %4$@।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于位于 %1$@、自 %2$@ 起租的房产租赁合同,依据西班牙《城市租赁法》(LAU)第 18 条及合同中的调整条款,现通知您:月租金上调 %3$@,%4$@。"
          }
        }
      }
    },
