    "cloud.advice.no_account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in the Settings app of your device and come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud en Ajustes de tu dispositivo y vuelve aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in den Einstellungen deines Geräts bei iCloud an und komm zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à iCloud dans les Réglages de votre appareil, puis revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a iCloud nelle Impostazioni del dispositivo e poi torna qui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão no iCloud nos Ajustes do seu dispositivo e volte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى iCloud من إعدادات جهازك ثم عُد إلى هنا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने डिवाइस की सेटिंग्स में iCloud में साइन इन करें और वापस आएँ।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设备的“设置”中登录 iCloud,然后返回此处。"
          }
        }
      }
    },
    "cloud.advice.restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is restricted on this device (parental controls or a profile). Sync cannot run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud está restringido en este dispositivo (control parental o un perfil). La sincronización no puede funcionar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist auf diesem Gerät eingeschränkt (Kindersicherung oder ein Profil). Die Synchronisierung kann nicht laufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est restreint sur cet appareil (contrôle parental ou profil). La synchronisation ne peut pas fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud è limitato su questo dispositivo (controlli parentali o un profilo). La sincronizzazione non può funzionare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está restrito neste dispositivo (controlo parental ou um perfil). A sincronização não pode funcionar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud مقيَّد على هذا الجهاز (بسبب الرقابة الأبوية أو ملف تعريف). لا يمكن تشغيل المزامنة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर iCloud प्रतिबंधित है (पैरेंटल कंट्रोल या कोई प्रोफ़ाइल)। सिंक नहीं चल सकता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的 iCloud 受到限制(家长控制或描述文件),无法同步。"
          }
        }
      }
    },
    "cloud.advice.account_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device was synced with another iCloud account. Nothing was mixed. Turn sync on again to merge this device's data with the new account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo estaba sincronizado con otra cuenta de iCloud. No se ha mezclado nada. Vuelve a activar la sincronización para combinar los datos de este dispositivo con la cuenta nueva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät war mit einem anderen iCloud-Account synchronisiert. Es wurde nichts vermischt. Aktiviere die Synchronisierung erneut, um die Daten dieses Geräts mit dem neuen Account zusammenzuführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil était synchronisé avec un autre compte iCloud. Rien n'a été mélangé. Réactivez la synchronisation pour fusionner les données de cet appareil avec le nouveau compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo era sincronizzato con un altro account iCloud. Nulla è stato mescolato. Riattiva la sincronizzazione per unire i dati di questo dispositivo al nuovo account."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo estava sincronizado com outra conta iCloud. Nada foi misturado. Volte a ativar a sincronização para juntar os dados deste dispositivo à nova conta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان هذا الجهاز متزامنًا مع حساب iCloud آخر. لم يُخلط شيء. فعّل المزامنة مجددًا لدمج بيانات هذا الجهاز مع الحساب الجديد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस किसी दूसरे iCloud खाते से सिंक था। कुछ भी मिलाया नहीं गया। इस डिवाइस का डेटा नए खाते के साथ मिलाने के लिए सिंक फिर चालू करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备之前与另一个 iCloud 账户同步,未混合任何数据。重新开启同步,即可将此设备的数据与新账户合并。"
          }
        }
      }
    },
    "cloud.advice.remote_deleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy in iCloud was deleted from another device. Sync is off here and your data on this device was not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia en iCloud se eliminó desde otro dispositivo. Aquí la sincronización está desactivada y tus datos en este dispositivo no se han tocado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie in iCloud wurde von einem anderen Gerät gelöscht. Die Synchronisierung ist hier aus und deine Daten auf diesem Gerät blieben unberührt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie dans iCloud a été supprimée depuis un autre appareil. La synchronisation est désactivée ici et vos données sur cet appareil n'ont pas été modifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia in iCloud è stata eliminata da un altro dispositivo. Qui la sincronizzazione è disattivata e i tuoi dati su questo dispositivo non sono stati toccati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia no iCloud foi eliminada a partir de outro dispositivo. Aqui a sincronização está desativada e os seus dados neste dispositivo não foram alterados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُذفت النسخة في iCloud من جهاز آخر. المزامنة متوقفة هنا ولم تُمسّ بياناتك على هذا الجهاز."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud की प्रति किसी दूसरे डिवाइस से हटा दी गई। यहाँ सिंक बंद है और इस डिवाइस पर आपके डेटा को छुआ नहीं गया।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 中的副本已在另一台设备上被删除。此处已关闭同步,本设备上的数据未受影响。"
          }
        }
      }
    },
    "cloud.advice.quota": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free some space in iCloud (Settings › Apple Account › iCloud) and sync will resume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera espacio en iCloud (Ajustes › Cuenta de Apple › iCloud) y la sincronización se reanudará."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaffe Platz in iCloud (Einstellungen › Apple-Account › iCloud), dann läuft die Synchronisierung weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérez de l'espace dans iCloud (Réglages › Compte Apple › iCloud) et la synchronisation reprendra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera spazio su iCloud (Impostazioni › Account Apple › iCloud) e la sincronizzazione riprenderà."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberte espaço no iCloud (Ajustes › Conta Apple › iCloud) e a sincronização será retomada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّر مساحة في iCloud (الإعدادات › حساب Apple › iCloud) وستُستأنف المزامنة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud में जगह खाली करें (सेटिंग्स › Apple खाता › iCloud) और सिंक फिर शुरू हो जाएगा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iCloud 中释放空间(设置 › Apple 账户 › iCloud),同步将自动恢复。"
          }
        }
      }
    },
    "cloud.advice.needs_update": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device uses a newer version of Renting. Update this app so nothing is misread."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro dispositivo usa una versión más nueva de Renting. Actualiza esta app para que nada se lea mal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Gerät nutzt eine neuere Version von Renting. Aktualisiere diese App, damit nichts falsch gelesen wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre appareil utilise une version plus récente de Renting. Mettez cette app à jour pour que rien ne soit mal interprété."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro dispositivo usa una versione più recente di Renting. Aggiorna questa app perché nulla venga letto male."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro dispositivo usa uma versão mais recente do Renting. Atualize esta app para que nada seja mal interpretado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم جهاز آخر إصدارًا أحدث من Renting. حدّث هذا التطبيق كي لا يُساء قراءة أي شيء."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरा डिवाइस Renting का नया संस्करण इस्तेमाल करता है। इस ऐप को अपडेट करें ताकि कुछ गलत न पढ़ा जाए।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备使用了更新版本的 Renting。请更新此应用,以免数据被误读。"
          }
        }
      }
    },
    "cloud.advice.demo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample data is never uploaded. Erase it in Settings to sync your real data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de ejemplo nunca se suben. Bórralos en Ajustes para sincronizar tus datos reales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispieldaten werden nie hochgeladen. Lösche sie in den Einstellungen, um deine echten Daten zu synchronisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données d'exemple ne sont jamais envoyées. Effacez-les dans les Réglages pour synchroniser vos vraies données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di esempio non vengono mai caricati. Cancellali nelle Impostazioni per sincronizzare i tuoi dati reali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de exemplo nunca são enviados. Apague-os nos Ajustes para sincronizar os seus dados reais."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُرفع البيانات التجريبية أبدًا. امسحها من الإعدادات لمزامنة بياناتك الحقيقية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमूना डेटा कभी अपलोड नहीं होता। अपना असली डेटा सिंक करने के लिए इसे सेटिंग्स में मिटाएँ।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例数据永远不会上传。请在“设置”中清除它,以同步你的真实数据。"
          }
        }
      }
    },
    "cloud.last %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last sync %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última sincronización %@"
          }
        },
        "de": {
