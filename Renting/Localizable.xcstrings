    "rule.lateRent.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warns when a tenant has not paid by the day you choose, and about partial payments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa cuando un inquilino no ha pagado el día que elijas, y de los pagos parciales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnt, wenn ein Mieter bis zum gewählten Tag nicht gezahlt hat, und bei Teilzahlungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévient quand un locataire n'a pas payé au jour choisi, et en cas de paiement partiel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisa quando un inquilino non ha pagato entro il giorno scelto e per i pagamenti parziali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa quando um inquilino não pagou até ao dia escolhido e nos pagamentos parciais."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينبّه عندما لا يدفع المستأجر حتى اليوم الذي تختاره، وعند الدفعات الجزئية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई किरायेदार चुने गए दिन तक भुगतान न करे, या आंशिक भुगतान हो, तब सूचित करता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "租客在你设定的日期前未付款或只付了部分款项时提醒。"
          }
        }
      }
    },
    "rule.expectedRent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rent still to come in this month"
          }
        },
        "es": {
