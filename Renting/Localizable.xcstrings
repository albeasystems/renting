    "letter.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written notice under article 18.2 of the LAU. Keep proof of sending. Generated with Renting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificación por escrito conforme al artículo 18.2 de la LAU. Conserve el justificante de envío. Generado con Renting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schriftliche Mitteilung gemäß Art. 18.2 LAU. Versandnachweis aufbewahren. Erstellt mit Renting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification écrite selon l'article 18.2 de la LAU. Conservez la preuve d'envoi. Générée avec Renting."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comunicazione scritta ai sensi dell'art. 18.2 LAU. Conservare la prova d'invio. Generata con Renting."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificação por escrito nos termos do artigo 18.2 da LAU. Guarde o comprovativo de envio. Gerado com Renting."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخطار كتابي وفق المادة 18.2 من LAU. احتفظ بإثبات الإرسال. أُنشئ بواسطة Renting."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LAU अनुच्छेद 18.2 के अंतर्गत लिखित सूचना। भेजने का प्रमाण रखें। Renting से बनाया गया।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依据 LAU 第 18.2 条出具的书面通知,请保留寄送凭证。由 Renting 生成。"
          }
        }
