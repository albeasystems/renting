    "contract.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The type decides which rules apply: only a LAU primary-residence lease follows the annual update (IRAV) and the income-tax reduction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo decide qué reglas se aplican: solo un contrato LAU de vivienda habitual sigue la actualización anual (IRAV) y la reducción del IRPF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vertragsart entscheidet, welche Regeln gelten: Nur ein LAU-Mietvertrag über den Hauptwohnsitz folgt der jährlichen Anpassung (IRAV) und der Steuerminderung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le type détermine les règles applicables : seul un bail LAU de résidence principale suit la révision annuelle (IRAV) et la réduction d'impôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tipo decide quali regole si applicano: solo un contratto LAU di abitazione principale segue l'adeguamento annuale (IRAV) e la riduzione fiscale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tipo decide que regras se aplicam: só um contrato LAU de residência permanente segue a atualização anual (IRAV) e a redução fiscal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد النوع القواعد المطبَّقة: وحده عقد LAU للسكن الدائم يخضع للتحديث السنوي (IRAV) والتخفيض الضريبي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकार तय करता है कि कौन-से नियम लागू होंगे: केवल LAU के स्थायी-निवास अनुबंध पर वार्षिक अद्यतन (IRAV) और आयकर कटौती लागू होती है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合同类型决定适用的规则:只有 LAU 常住住房租约才适用年度调整(IRAV)和个税减免。"
          }
        }
      }
    },
