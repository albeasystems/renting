    "props.collections.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldest month first, current month last. Tick months in the Collections tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mes más antiguo primero y el actual al final. Marca los cobros en la pestaña Cobros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältester Monat zuerst, aktueller zuletzt. Hake die Zahlungen im Reiter „Zahlungen“ ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mois le plus ancien en premier, le mois en cours en dernier. Cochez les encaissements dans l'onglet Encaissements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima il mese più vecchio, il mese corrente per ultimo. Segna gli incassi nella scheda Incassi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mês mais antigo primeiro e o atual no fim. Marque as cobranças no separador Cobranças."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشهر الأقدم أولًا والحالي في الآخر. حدّد التحصيلات من تبويب التحصيل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे पुराना माह पहले, चालू माह अंत में। वसूली टैब में वसूली चिह्नित करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最早的月份在前,当前月份在后。请在“收租”标签页标记收款。"
          }
        }
      }
    },
