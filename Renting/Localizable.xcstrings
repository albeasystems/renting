    "tenant.exit.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the following month, no rent will be expected from this tenant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir del mes siguiente ya no se esperará renta de este inquilino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab dem Folgemonat wird von diesem Mieter keine Miete mehr erwartet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir du mois suivant, aucun loyer ne sera attendu de ce locataire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal mese successivo non sarà previsto alcun affitto da questo inquilino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir do mês seguinte, não será esperado aluguel deste inquilino."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعتبارًا من الشهر التالي لن يُتوقع إيجار من هذا المستأجر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले माह से इस किरायेदार से किराया अपेक्षित नहीं होगा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自下个月起不再向该租客收租。"
          }
        }
      }
    },
