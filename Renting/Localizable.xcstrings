    "tenant.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment history will be deleted too. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se borrará su historial de cobros. No se puede deshacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch sein Zahlungsverlauf wird gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son historique de paiements sera aussi supprimé. Action irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà eliminato anche lo storico dei pagamenti. L'azione non si può annullare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de pagamentos também será excluído. Não é possível desfazer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف سجل دفعاته أيضًا. لا يمكن التراجع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनका भुगतान इतिहास भी हट जाएगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其收款记录也将被删除,且无法撤销。"
          }
        }
      }
    },
