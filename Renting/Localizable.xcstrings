    "settings.erase.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homes, tenants, payments and expenses will be deleted. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán viviendas, inquilinos, cobros y gastos. No se puede deshacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohnungen, Mieter, Zahlungen und Ausgaben werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logements, locataires, paiements et dépenses seront supprimés. Action irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immobili, inquilini, incassi e spese verranno eliminati. L'azione non si può annullare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imóveis, inquilinos, pagamentos e despesas serão excluídos. Não é possível desfazer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف العقارات والمستأجرين والدفعات والمصروفات. لا يمكن التراجع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवास, किरायेदार, भुगतान और खर्च हट जाएँगे। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房产、租客、收款和支出将被删除,且无法撤销。"
          }
        }
      }
    },
