    "plan.f.tenants_adv.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contract type and rent insurance, yearly rent update (IRAV/CPI) with its letter, deposit filing, income-tax reduction per contract and rent receipts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo de contrato y seguro de impago, actualización anual de renta (IRAV/IPC) con su carta, control del depósito de la fianza, reducción del IRPF por contrato y recibos de alquiler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertragsart und Mietausfallversicherung, jährliche Mietanpassung (IRAV/VPI) mit Schreiben, Kautionshinterlegung, Steuerminderung je Vertrag und Mietquittungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Type de contrat et assurance loyers impayés, révision annuelle du loyer (IRAV/IPC) avec son courrier, suivi du dépôt de la caution, réduction d'impôt par bail et quittances de loyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo di contratto e assicurazione sul mancato pagamento, adeguamento annuale del canone (IRAV/IPC) con la lettera, deposito della cauzione, riduzione fiscale per contratto e ricevute d'affitto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo de contrato e seguro de incumprimento, atualização anual da renda (IRAV/IPC) com a carta, depósito da caução, redução fiscal por contrato e recibos de aluguel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نوع العقد وتأمين عدم سداد الإيجار، والتحديث السنوي للإيجار (IRAV/IPC) مع خطابه، ومتابعة إيداع التأمين، والتخفيض الضريبي لكل عقد، وإيصالات الإيجار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुबंध का प्रकार और किराया चूक बीमा, पत्र सहित वार्षिक किराया अद्यतन (IRAV/IPC), जमा राशि का पंजीकरण, प्रति अनुबंध आयकर कटौती और किराया रसीदें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合同类型与租金违约保险、含函件的年度租金调整(IRAV/IPC)、押金备案、按合同的个税减免,以及租金收据。"
          }
        }
      }
    },
