    "cloud.f.backup.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change phone or reinstall and get everything back. Only you can read it: it never goes through our servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de móvil o reinstala y recupera todo. Solo tú puedes leerlo: no pasa por nuestros servidores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neues Handy oder Neuinstallation: alles ist wieder da. Nur du kannst es lesen, es läuft nie über unsere Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez de téléphone ou réinstallez et retrouvez tout. Vous seul pouvez le lire : rien ne passe par nos serveurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia telefono o reinstalla e ritrovi tutto. Solo tu puoi leggerlo: non passa dai nostri server."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude de telemóvel ou reinstale e recupere tudo. Só você pode ler: não passa pelos nossos servidores."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدّل هاتفك أو أعد التثبيت واستعد كل شيء. أنت وحدك تستطيع قراءته: لا يمر عبر خوادمنا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन बदलें या ऐप दोबारा इंस्टॉल करें, सब कुछ वापस मिलेगा। इसे केवल आप पढ़ सकते हैं: यह हमारे सर्वर से नहीं गुज़रता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换手机或重装后一切都能恢复。只有你能读取,数据不会经过我们的服务器。"
          }
        }
      }
    },
