    "coll.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to tick a month. Long-press for partial or late payments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para marcar un mes. Mantén pulsado para pagos parciales o tardíos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen zum Abhaken. Gedrückt halten für Teil- oder Spätzahlungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour cocher un mois. Appui long pour les paiements partiels ou tardifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per spuntare un mese. Tieni premuto per pagamenti parziali o in ritardo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para marcar um mês. Mantenha pressionado para pagamentos parciais ou atrasados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لتحديد الشهر. اضغط مطولًا للدفعات الجزئية أو المتأخرة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महीने पर टिक के लिए टैप करें। आंशिक या देर से भुगतान के लिए देर तक दबाएँ।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按勾选月份;长按可记录部分或延迟付款。"
          }
        }
      }
    },
