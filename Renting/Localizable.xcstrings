    },
    "kpi.eq.split %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of every 100 € collected: %1$lld € go to expenses and %2$lld € are left for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada 100 € que cobras: %1$lld € se van en gastos y te quedan %2$lld €."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von je 100 €, die du einnimmst: %1$lld € gehen für Ausgaben drauf, %2$lld € bleiben dir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur 100 € encaissés : %1$lld € partent en dépenses et %2$lld € vous restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni 100 € incassati: %1$lld € se ne vanno in spese e %2$lld € restano a te."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada 100 € que recebe: %1$lld € vão para despesas e ficam %2$lld € para si."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من كل 100 € تحصّلها: يذهب %1$lld € إلى المصروفات ويبقى لك %2$lld €."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर 100 € की वसूली में से: %1$lld € खर्चों में जाते हैं और %2$lld € आपके पास बचते हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每收取 100 €:%1$lld € 用于支出,%2$lld € 留给你。"
          }
        }
      }
    },
    "kpi.eq.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Net profit is a cash figure: what really came in during the month minus what you paid or must pay for the same month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El beneficio neto es una cifra de caja: lo que realmente ha entrado en el mes menos lo que has pagado o debes pagar de ese mismo mes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Nettogewinn ist eine Kassengröße: was im Monat tatsächlich eingegangen ist, abzüglich dessen, was du für denselben Monat bezahlt hast oder noch zahlen musst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bénéfice net est un chiffre de trésorerie : ce qui est réellement entré dans le mois moins ce que vous avez payé ou devez payer pour ce même mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'utile netto è una cifra di cassa: ciò che è entrato davvero nel mese meno ciò che hai pagato o devi pagare per lo stesso mese."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O lucro líquido é um valor de caixa: o que realmente entrou no mês menos o que pagou ou tem de pagar nesse mesmo mês."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صافي الربح رقم نقدي: ما دخل فعليًا خلال الشهر ناقص ما دفعته أو يجب أن تدفعه عن الشهر نفسه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुद्ध लाभ एक नकद आँकड़ा है: माह में वास्तव में जो आया, उसमें से उसी माह के लिए जो आपने चुकाया या चुकाना है, घटाकर।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "净利润是现金口径:当月实际收到的款项,减去你为同一个月已付或应付的费用。"
          }
        }
      }
    },
