    "onb.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rent, expenses and tenants for homes and rooms — all in one place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alquileres, gastos e inquilinos de pisos y habitaciones, todo en un sitio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miete, Ausgaben und Mieter für Wohnungen und Zimmer – alles an einem Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loyers, dépenses et locataires de logements et chambres, au même endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affitti, spese e inquilini di case e stanze, tutto in un posto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aluguéis, despesas e inquilinos de imóveis e quartos, tudo em um só lugar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإيجارات والمصروفات والمستأجرون للشقق والغرف في مكان واحد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घरों और कमरों के किराये, खर्च और किरायेदार — सब एक जगह।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房屋与房间的租金、支出和租客,一站式管理。"
          }
        }
      }
    },
    "onb.b1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
