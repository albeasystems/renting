    "exp.manager_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does your manager charge a percentage of the rent? Set it up in the home (Homes › Edit) and the commission is calculated every month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tu gestor cobra un porcentaje del alquiler? Configúralo en la vivienda (Viviendas › Editar) y la comisión se calcula cada mes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet deine Verwaltung einen Prozentsatz der Miete? Richte ihn in der Wohnung ein (Wohnungen › Bearbeiten), dann wird die Provision jeden Monat berechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre gestionnaire prend un pourcentage du loyer ? Configurez-le dans le logement (Logements › Modifier) et la commission est calculée chaque mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo gestore applica una percentuale sul canone? Impostala nell'immobile (Immobili › Modifica) e la commissione viene calcolata ogni mese."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu gestor cobra uma percentagem da renda? Configure-a no imóvel (Imóveis › Editar) e a comissão é calculada todos os meses."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يتقاضى مديرك نسبة من الإيجار؟ اضبطها في العقار (العقارات › تعديل) وستُحسب العمولة كل شهر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आपका प्रबंधक किराये का प्रतिशत लेता है? इसे आवास में सेट करें (आवास › संपादित करें), कमीशन हर महीने गणना होगा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理人按租金比例收费?请在房产中设置(房产 › 编辑),佣金将每月自动计算。"
          }
        }
      }
    },
