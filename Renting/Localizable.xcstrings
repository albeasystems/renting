    "quick.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income is what tenants paid (rent plus utilities); expenses are what falls due in the period. Red marks what is still owed or unpaid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ingresos son lo que pagaron los inquilinos (alquiler más suministros); los gastos, lo que vence en el periodo. En rojo, lo que aún se debe o está sin pagar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmen sind das, was Mieter gezahlt haben (Miete plus Nebenkosten); Ausgaben das, was im Zeitraum fällig wird. Rot markiert Offenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus sont ce que les locataires ont payé (loyer plus charges) ; les dépenses, ce qui arrive à échéance sur la période. En rouge : ce qui reste dû ou impayé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate sono ciò che hanno pagato gli inquilini (canone più utenze); le spese, ciò che scade nel periodo. In rosso, ciò che è ancora dovuto o non pagato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As receitas são o que os inquilinos pagaram (renda mais consumos); as despesas, o que vence no período. A vermelho, o que ainda está em dívida ou por pagar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإيرادات هي ما دفعه المستأجرون (الإيجار والمرافق)؛ والمصروفات ما يستحق في الفترة. الأحمر يشير إلى ما لا يزال مستحقًا أو غير مدفوع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आय वह है जो किरायेदारों ने दिया (किराया और उपयोगिताएँ); खर्च वे हैं जो अवधि में देय हैं। लाल रंग बकाया या अवैतनिक दर्शाता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收入为租客已付金额(租金加水电杂费);支出为该期间到期的费用。红色表示仍欠或未付。"
          }
        }
      }
    },
