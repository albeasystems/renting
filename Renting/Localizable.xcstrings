    "cloud.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data goes from your devices to your own iCloud, protected by your Apple Account. It never goes through our servers and we cannot see it. It uses a little of your iCloud storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos van de tus dispositivos a tu propio iCloud, protegido por tu cuenta de Apple. No pasan por nuestros servidores y no podemos verlos. Ocupan un poco de tu almacenamiento de iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten gehen von deinen Geräten in dein eigenes iCloud, geschützt durch deinen Apple-Account. Sie laufen nie über unsere Server und wir können sie nicht sehen. Sie belegen etwas von deinem iCloud-Speicher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données vont de vos appareils vers votre propre iCloud, protégées par votre compte Apple. Elles ne passent jamais par nos serveurs et nous ne pouvons pas les voir. Elles occupent un peu de votre stockage iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati vanno dai tuoi dispositivi al tuo iCloud, protetti dal tuo account Apple. Non passano mai dai nostri server e non possiamo vederli. Occupano un po' del tuo spazio iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus dados vão dos seus dispositivos para o seu próprio iCloud, protegidos pela sua conta Apple. Nunca passam pelos nossos servidores e não os podemos ver. Ocupam um pouco do seu armazenamento iCloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتقل بياناتك من أجهزتك إلى iCloud الخاص بك، محميةً بحساب Apple الخاص بك. لا تمر عبر خوادمنا أبدًا ولا يمكننا الاطلاع عليها. وتستهلك جزءًا يسيرًا من مساحة iCloud لديك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा आपके डिवाइस से आपके अपने iCloud में जाता है, जो आपके Apple खाते से सुरक्षित है। यह हमारे सर्वर से कभी नहीं गुज़रता और हम इसे देख नहीं सकते। यह आपके iCloud स्टोरेज का थोड़ा-सा हिस्सा लेता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的数据从你的设备传到你自己的 iCloud,由你的 Apple 账户保护。数据不会经过我们的服务器,我们也无法查看。它会占用少量 iCloud 存储空间。"
          }
        }
      }
    },
    "cloud.enable.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on iCloud sync?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Activar la sincronización con iCloud?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Synchronisierung aktivieren?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
