    "cloud.active.includes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription includes unlimited homes, the advanced tools, receipts, alerts and no ads while it is active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción incluye viviendas ilimitadas, las herramientas avanzadas, recibos, alertas y sin anuncios mientras esté activa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo umfasst unbegrenzt viele Wohnungen, die erweiterten Werkzeuge, Quittungen, Hinweise und keine Werbung, solange es aktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement comprend des logements illimités, les outils avancés, les quittances, les alertes et l'absence de publicité tant qu'il est actif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento include immobili illimitati, gli strumenti avanzati, le ricevute, gli avvisi e nessuna pubblicità finché è attivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua subscrição inclui imóveis ilimitados, as ferramentas avançadas, recibos, alertas e ausência de anúncios enquanto estiver ativa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل اشتراكك عقارات بلا حدود والأدوات المتقدمة والإيصالات والتنبيهات وبلا إعلانات طالما هو فعّال."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सदस्यता सक्रिय रहने तक असीमित आवास, उन्नत टूल, रसीदें, अलर्ट और विज्ञापन-मुक्त अनुभव शामिल करती है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅有效期间包含房产数量不限、高级工具、收据、提醒和无广告。"
          }
        }
      }
    },
    "cloud.active.pro_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you cancel, you go back to the free plan. You keep all your data; the advanced fields keep their values but cannot be edited, and sync stops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cancelas, vuelves al plan gratis. Conservas todos tus datos; los campos avanzados mantienen sus valores pero no se pueden editar, y la sincronización se detiene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du kündigst, kehrst du zum kostenlosen Plan zurück. Alle Daten bleiben erhalten; die erweiterten Felder behalten ihre Werte, lassen sich aber nicht mehr bearbeiten, und die Synchronisierung endet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous résiliez, vous revenez au plan gratuit. Vous gardez toutes vos données ; les champs avancés conservent leurs valeurs mais ne sont plus modifiables, et la synchronisation s'arrête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se annulli, torni al piano gratuito. Conservi tutti i dati; i campi avanzati mantengono i valori ma non si possono più modificare, e la sincronizzazione si interrompe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cancelar, volta ao plano gratuito. Mantém todos os dados; os campos avançados conservam os valores mas já não podem ser editados, e a sincronização para."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا ألغيت الاشتراك تعود إلى الخطة المجانية. تحتفظ بجميع بياناتك؛ تبقى قيم الحقول المتقدمة كما هي لكن لا يمكن تعديلها، وتتوقف المزامنة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप रद्द करते हैं तो मुफ़्त प्लान पर लौट जाते हैं। आपका सारा डेटा सुरक्षित रहता है; उन्नत फ़ील्ड अपने मान रखते हैं पर संपादित नहीं हो सकते, और सिंक रुक जाता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消后将回到免费方案。你的所有数据都会保留;高级字段保留原有数值但不能再编辑,同步也会停止。"
          }
        }
      }
    },
