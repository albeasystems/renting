    "setup.home.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with the home or the rooms you rent out. You can change everything later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por la vivienda o las habitaciones que alquilas. Todo se puede cambiar después."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit der Wohnung oder den Zimmern, die du vermietest. Alles lässt sich später ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par le logement ou les chambres que vous louez. Tout peut se modifier ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia dall'immobile o dalle stanze che affitti. Potrai cambiare tutto in seguito."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece pelo imóvel ou pelos quartos que arrenda. Tudo pode ser alterado depois."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بالعقار أو الغرف التي تؤجّرها. يمكنك تغيير كل شيء لاحقًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस आवास या कमरों से शुरू करें जिन्हें आप किराये पर देते हैं। सब कुछ बाद में बदला जा सकता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先从你出租的房产或房间开始。之后一切都可以修改。"
          }
        }
      }
    },
