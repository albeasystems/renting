    "occ.info.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share of the days with a tenant, per year. Each room counts from the day it first had a tenant, and the current year up to today. Every room weighs the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porcentaje de días con inquilino, por año. Cada habitación cuenta desde el día en que tuvo su primer inquilino, y el año en curso hasta hoy. Todas las habitaciones pesan igual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteil der Tage mit Mieter, pro Jahr. Jedes Zimmer zählt ab dem Tag, an dem es zum ersten Mal einen Mieter hatte, das laufende Jahr bis heute. Alle Zimmer zählen gleich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Part des jours avec locataire, par année. Chaque chambre compte à partir du jour où elle a eu son premier locataire, et l'année en cours jusqu'à aujourd'hui. Toutes les chambres pèsent autant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quota di giorni con inquilino, per anno. Ogni stanza conta dal giorno in cui ha avuto il primo inquilino e l'anno in corso fino a oggi. Tutte le stanze pesano allo stesso modo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentagem de dias com inquilino, por ano. Cada quarto conta a partir do dia em que teve o primeiro inquilino e o ano em curso até hoje. Todos os quartos pesam o mesmo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسبة الأيام التي كان فيها مستأجر، لكل سنة. تُحسب كل غرفة من يوم استقبلت فيه أول مستأجر، والسنة الجارية حتى اليوم. وتتساوى الغرف في الوزن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर वर्ष में किरायेदार वाले दिनों का अनुपात। प्रत्येक कमरा उस दिन से गिना जाता है जब उसमें पहला किरायेदार आया, और चालू वर्ष आज तक। सभी कमरों का वज़न समान है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每年有租客的天数占比。每个房间从首次有租客的那天起计算,当年计算到今天。所有房间权重相同。"
          }
        }
      }
    },
    "occ.info.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The history appears once a home has had a tenant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial aparece cuando una vivienda ha tenido algún inquilino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf erscheint, sobald eine Wohnung einen Mieter hatte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique apparaît dès qu'un logement a eu un locataire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo storico compare quando un immobile ha avuto un inquilino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico aparece quando um imóvel tiver tido um inquilino."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر السجل بمجرد أن يكون للعقار مستأجر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास तब दिखेगा जब किसी आवास में कोई किरायेदार रहा हो।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房产有过租客后才会显示历史。"
          }
        }
      }
    },
