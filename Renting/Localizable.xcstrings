    "summary.net_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under each amount: net after expenses (shared expenses are split equally between rooms)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajo cada importe: neto tras gastos (los gastos comunes se reparten a partes iguales entre habitaciones)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter jedem Betrag: netto nach Ausgaben (gemeinsame Kosten werden gleichmäßig auf die Zimmer verteilt)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous chaque montant : net après dépenses (les charges communes sont réparties à parts égales entre les chambres)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto ogni importo: netto dopo le spese (le spese comuni sono divise in parti uguali tra le stanze)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixo de cada valor: líquido após despesas (despesas comuns divididas igualmente entre os quartos)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحت كل مبلغ: الصافي بعد المصروفات (تُقسَّم المصروفات المشتركة بالتساوي بين الغرف)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर राशि के नीचे: खर्च के बाद शुद्ध (साझा खर्च कमरों में बराबर बाँटे जाते हैं)।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每项金额下方为扣除支出后的净额(公共支出在各房间间平均分摊)。"
          }
        }
      }
    },
    "alerts.teaser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdue rent, expenses coming up, contracts ending and deposits to return — all in one list with the subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alquileres impagados, gastos que vencen, contratos que terminan y fianzas por devolver, todo en una lista con la suscripción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überfällige Mieten, anstehende Ausgaben, auslaufende Verträge und zurückzugebende Kautionen – alles in einer Liste mit dem Abo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loyers impayés, dépenses à venir, baux qui se terminent et cautions à rendre, le tout dans une seule liste avec l'abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affitti non pagati, spese in arrivo, contratti in scadenza e cauzioni da restituire, tutto in un'unica lista con l'abbonamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendas em atraso, despesas a vencer, contratos a terminar e cauções a devolver, tudo numa só lista com a subscrição."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيجارات متأخرة ومصروفات قادمة وعقود تنتهي وتأمينات للإرجاع، كلها في قائمة واحدة مع الاشتراك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बकाया किराया, आने वाले खर्च, समाप्त होते अनुबंध और लौटाई जाने वाली जमा राशियाँ, सब एक सूची में, सदस्यता के साथ।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逾期租金、即将到期的支出、即将结束的合同和待退押金,订阅后集中在一个列表中。"
          }
        }
      }
    },
