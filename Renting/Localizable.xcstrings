    "setup.tenant.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a tenant and their rent you can start ticking collections each month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un inquilino y su alquiler ya puedes marcar los cobros de cada mes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Mieter und seiner Miete kannst du jeden Monat die Zahlungen abhaken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un locataire et son loyer, vous pouvez cocher les encaissements de chaque mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un inquilino e il suo canone puoi segnare gli incassi di ogni mese."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um inquilino e a sua renda, já pode marcar as cobranças de cada mês."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع مستأجر وإيجاره يمكنك تحديد التحصيلات كل شهر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किरायेदार और उसके किराये के साथ आप हर माह की वसूली चिह्नित कर सकते हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
