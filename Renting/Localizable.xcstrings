    "fiscal.supplies_excluded %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not include %@ of utilities tenants paid on top of the rent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No incluye %@ de suministros que pagaron los inquilinos además del alquiler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne %@ Nebenkosten, die Mieter zusätzlich zur Miete gezahlt haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'inclut pas %@ de charges payées par les locataires en plus du loyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non include %@ di utenze pagate dagli inquilini oltre al canone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não inclui %@ de consumos pagos pelos inquilinos além da renda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يشمل %@ من المرافق التي دفعها المستأجرون فوق الإيجار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किराये के ऊपर किरायेदारों द्वारा दी गई %@ की उपयोगिताएँ शामिल नहीं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不含租客在租金之外支付的 %@ 水电杂费。"
          }
        }
      }
    },
