    "pro.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything unlocked: unlimited homes, advanced tools for homes, tenants and taxes, no ads and sync across your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo desbloqueado: viviendas ilimitadas, herramientas avanzadas para viviendas, inquilinos e impuestos, sin anuncios y sincronización entre tus dispositivos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles freigeschaltet: unbegrenzt viele Wohnungen, erweiterte Werkzeuge für Wohnungen, Mieter und Steuern, keine Werbung und Synchronisierung auf all deinen Geräten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est débloqué : logements illimités, outils avancés pour les logements, les locataires et les impôts, sans publicité et synchronisation entre vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto sbloccato: immobili illimitati, strumenti avanzati per immobili, inquilini e tasse, senza pubblicità e sincronizzazione tra i tuoi dispositivi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo desbloqueado: imóveis ilimitados, ferramentas avançadas para imóveis, inquilinos e impostos, sem anúncios e sincronização entre os seus dispositivos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء مفتوح: عقارات بلا حدود، وأدوات متقدمة للعقارات والمستأجرين والضرائب، بلا إعلانات، ومزامنة بين أجهزتك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ अनलॉक: असीमित आवास, आवास, किरायेदार और कर के लिए उन्नत टूल, विज्ञापन-मुक्त अनुभव और आपके सभी उपकरणों में सिंक।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部解锁:房产数量不限,房产、租客和税务的高级工具,无广告,并在你的设备间同步。"
          }
        }
      }
    },
