    "cloud.toggle.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes sync by themselves within seconds when you are online. Edits made offline go up when you reconnect. If two devices edit the same item, the most recent edit wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se sincronizan solos en segundos cuando tienes conexión. Lo que edites sin conexión se sube al reconectar. Si dos dispositivos editan lo mismo, gana la edición más reciente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden online innerhalb von Sekunden automatisch synchronisiert. Offline vorgenommene Änderungen werden beim erneuten Verbinden hochgeladen. Bearbeiten zwei Geräte dasselbe Element, gewinnt die neueste Änderung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications se synchronisent d'elles-mêmes en quelques secondes lorsque vous êtes en ligne. Celles faites hors ligne sont envoyées à la reconnexion. Si deux appareils modifient le même élément, la modification la plus récente l'emporte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche si sincronizzano da sole in pochi secondi quando sei online. Quelle fatte offline vengono caricate alla riconnessione. Se due dispositivi modificano lo stesso elemento, vince la modifica più recente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações sincronizam-se sozinhas em segundos quando está online. As feitas offline são enviadas quando voltar a ligar. Se dois dispositivos editarem o mesmo item, vence a edição mais recente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتزامن التغييرات تلقائيًا خلال ثوانٍ عند اتصالك بالإنترنت. أما التعديلات دون اتصال فتُرفع عند إعادة الاتصال. وإذا عدّل جهازان العنصر نفسه فتفوز آخر عملية تعديل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन होने पर बदलाव कुछ सेकंड में अपने-आप सिंक हो जाते हैं। ऑफ़लाइन किए गए बदलाव दोबारा कनेक्ट होने पर अपलोड होते हैं। यदि दो डिवाइस एक ही चीज़ संपादित करें, तो सबसे ताज़ा संपादन मान्य होता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联网时,更改会在几秒内自动同步;离线所做的更改会在重新联网后上传。如果两台设备编辑了同一项,以最近的编辑为准。"
          }
        }
      }
    },
    "cloud.what": {
      "extractionState": "manual",
      "localizations": {
