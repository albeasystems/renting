    "plan.f.homes_adv.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manager or agency with its fee and VAT, construction and cadastral values, own-home flag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestor o agencia con su comisión e IVA, valores de construcción y catastral, vivienda habitual del propietario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalter oder Agentur mit Gebühr und MwSt., Bau- und Katasterwerte, eigene Wohnung des Eigentümers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionnaire ou agence avec ses honoraires et la TVA, valeurs de construction et cadastrale, résidence du propriétaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestore o agenzia con commissione e IVA, valori di costruzione e catastale, abitazione del proprietario."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestor ou agência com a sua comissão e IVA, valores de construção e catastral, habitação do proprietário."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدير أو الوكالة مع عمولته وضريبة القيمة المضافة، وقيمتا البناء والتسجيل العقاري، وإشارة سكن المالك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रबंधक या एजेंसी, उनकी फ़ीस और VAT के साथ, निर्माण और कैडस्ट्रल मूल्य, और मालिक का अपना निवास चिह्न।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理人或中介及其佣金和增值税、建筑价值与地籍价值、业主自住标记。"
          }
        }
      }
    },
