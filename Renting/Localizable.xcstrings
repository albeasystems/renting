    "backup.export.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the file wherever you like: Files, Drive, Dropbox, e-mail… It contains your tenants' personal data, so store it somewhere safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el archivo donde quieras: Archivos, Drive, Dropbox, correo… Contiene datos personales de tus inquilinos: guárdalo en un lugar seguro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre die Datei, wo du möchtest: Dateien, Drive, Dropbox, E-Mail … Sie enthält persönliche Daten deiner Mieter, also lege sie an einem sicheren Ort ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le fichier où vous voulez : Fichiers, Drive, Dropbox, e-mail… Il contient les données personnelles de vos locataires : rangez-le en lieu sûr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva il file dove preferisci: File, Drive, Dropbox, e-mail… Contiene i dati personali dei tuoi inquilini: tienilo in un luogo sicuro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde o ficheiro onde quiser: Ficheiros, Drive, Dropbox, e-mail… Contém dados pessoais dos seus inquilinos: guarde-o num local seguro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالملف أينما تشاء: الملفات أو Drive أو Dropbox أو البريد… يحتوي على بيانات شخصية لمستأجريك، فاحفظه في مكان آمن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल को जहाँ चाहें रखें: फ़ाइलें, Drive, Dropbox, ईमेल… इसमें आपके किरायेदारों का व्यक्तिगत डेटा है, इसलिए इसे सुरक्षित जगह रखें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件可以放在任何地方:文件 App、Drive、Dropbox、邮件……其中包含租客的个人数据,请妥善保管。"
          }
        }
      }
    },
    "backup.export.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is nothing to save yet: add your homes first. The sample data is never saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada que guardar: añade primero tus viviendas. Los datos de ejemplo nunca se guardan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch nichts zu sichern: Füge zuerst deine Wohnungen hinzu. Die Beispieldaten werden nie gesichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a encore rien à enregistrer : ajoutez d'abord vos logements. Les données d'exemple ne sont jamais enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è ancora nulla da salvare: aggiungi prima i tuoi immobili. I dati di esempio non vengono mai salvati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada para guardar: adicione primeiro os seus imóveis. Os dados de exemplo nunca são guardados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شيء للحفظ بعد: أضف عقاراتك أولًا. لا تُحفظ البيانات التجريبية أبدًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी सहेजने के लिए कुछ नहीं है: पहले अपने आवास जोड़ें। नमूना डेटा कभी नहीं सहेजा जाता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可保存的内容:请先添加房产。示例数据不会被保存。"
          }
        }
      }
    },
