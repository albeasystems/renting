    "kpi.margin.per100": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of every 100 € you collect, %1$ld € are left"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada 100 € que cobras te quedan %1$ld €"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von je 100 €, die du einnimmst, bleiben dir %1$ld €"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur 100 € encaissés, il vous reste %1$ld €"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni 100 € che incassi, te ne restano %1$ld €"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada 100 € que recebe, ficam-lhe %1$ld €"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من كل 100 € تحصّلها يبقى لك %1$ld €"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर 100 € की वसूली में से आपके पास %1$ld € बचते हैं"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每收取 100 €,你能留下 %1$ld €"
          }
        }
      }
    },
    "kpi.margin.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share of everything you collect that you keep. It lets you compare months with different rents and see if costs grow faster than income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte de todo lo que cobras que te quedas. Permite comparar meses con rentas distintas y ver si los costes crecen más rápido que los ingresos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anteil an allem Eingenommenen, der dir bleibt. So kannst du Monate mit unterschiedlichen Mieten vergleichen und sehen, ob die Kosten schneller wachsen als die Einnahmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La part de tout ce que vous encaissez que vous conservez. Elle permet de comparer des mois aux loyers différents et de voir si les coûts augmentent plus vite que les revenus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La quota di tutto ciò che incassi che ti resta. Permette di confrontare mesi con canoni diversi e di vedere se i costi crescono più in fretta dei ricavi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A parte de tudo o que recebe que fica consigo. Permite comparar meses com rendas diferentes e ver se os custos crescem mais depressa do que os rendimentos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسبة ما تحتفظ به من كل ما تحصّله. تتيح مقارنة أشهر ذات إيجارات مختلفة ومعرفة ما إذا كانت التكاليف تنمو أسرع من الدخل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो कुछ वसूलते हैं उसमें से जितना आपके पास रहता है, उसका अनुपात। इससे अलग-अलग किराए वाले महीनों की तुलना होती है और दिखता है कि लागत आय से तेज़ बढ़ रही है या नहीं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你所收款项中最终留下的比例。可用来比较租金不同的月份,并判断成本增长是否快于收入。"
          }
        }
      }
    },
    "kpi.margin.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Net ÷ collected. A margin that falls over several months means expenses are growing faster than your income. To improve it: update the rent, cut recurring expenses and make sure utilities are charged to tenants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Neto ÷ cobrado. Un margen que baja durante varios meses indica que los gastos crecen más rápido que tus ingresos. Para mejorarlo: actualiza la renta, recorta gastos recurrentes y asegúrate de repercutir los suministros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netto ÷ eingenommen. Sinkt die Marge über mehrere Monate, wachsen die Ausgaben schneller als deine Einnahmen. So verbesserst du sie: Miete anpassen, laufende Ausgaben senken und dafür sorgen, dass Nebenkosten an die Mieter weitergegeben werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Net ÷ encaissé. Une marge qui baisse pendant plusieurs mois signifie que les dépenses augmentent plus vite que vos revenus. Pour l'améliorer : révisez le loyer, réduisez les dépenses récurrentes et veillez à répercuter les charges sur les locataires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Netto ÷ incassato. Un margine che scende per più mesi indica che le spese crescono più in fretta delle entrate. Per migliorarlo: aggiorna il canone, riduci le spese ricorrenti e assicurati di addebitare le utenze agli inquilini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Líquido ÷ recebido. Uma margem que desce durante vários meses indica que as despesas crescem mais depressa do que os seus rendimentos. Para a melhorar: atualize a renda, corte as despesas recorrentes e garanta que os consumos são cobrados aos inquilinos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصافي ÷ المحصَّل. هبوط الهامش على مدى عدة أشهر يعني أن المصروفات تنمو أسرع من دخلك. لتحسينه: حدّث الإيجار، وقلّص المصروفات المتكررة، وتأكد من تحميل المرافق على المستأجرين."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुद्ध ÷ वसूला। कई महीनों तक मार्जिन गिरना बताता है कि खर्च आपकी आय से तेज़ बढ़ रहे हैं। इसे सुधारने के लिए: किराया अद्यतन करें, आवर्ती खर्च घटाएँ और सुनिश्चित करें कि उपयोगिताएँ किरायेदारों से वसूली जा रही हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "净额 ÷ 已收。利润率连续数月下降,说明支出增长快于收入。改善方法:调整租金、削减经常性支出,并确保水电杂费已向租客收取。"
          }
        }
      }
    },
