    "upd.form.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Index of the contract. Automatic: IRAV for contracts from 26/05/2023, CPI for older ones, and what is agreed for seasonal lets. Without an express clause the rent cannot be updated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice del contrato. Automático: IRAV para contratos desde el 26/05/2023, IPC para los anteriores y lo pactado en temporada. Sin cláusula expresa no se puede actualizar la renta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Index des Vertrags. Automatisch: IRAV für Verträge ab 26.05.2023, VPI für ältere und das Vereinbarte bei befristeter Miete. Ohne ausdrückliche Klausel ist keine Anpassung möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indice du contrat. Automatique : IRAV pour les contrats depuis le 26/05/2023, IPC pour les plus anciens, et ce qui est convenu pour le saisonnier. Sans clause expresse, le loyer ne peut pas être révisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indice del contratto. Automatico: IRAV per i contratti dal 26/05/2023, IPC per i precedenti e quanto pattuito per il transitorio. Senza clausola espressa il canone non può essere adeguato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice do contrato. Automático: IRAV para contratos desde 26/05/2023, IPC para os anteriores e o acordado na temporada. Sem cláusula expressa não se pode atualizar a renda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤشر العقد. تلقائي: IRAV للعقود منذ 26/05/2023 وIPC للأقدم وما اتُّفق عليه في الإيجار الموسمي. دون بند صريح لا يجوز تحديث الإيجار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुबंध का सूचकांक। स्वचालित: 26/05/2023 से अनुबंधों पर IRAV, पुराने पर IPC, और मौसमी किराये में जो तय हो। स्पष्ट खंड के बिना किराया नहीं बढ़ सकता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合同指数。自动:2023/05/26 起的合同用 IRAV,更早的用 IPC,短期租按约定。无明确条款不得调整租金。"
          }
        }
      }
    },
