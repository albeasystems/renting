    "exp.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add community fees, IBI, insurance, bills… monthly, quarterly or yearly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade comunidad, IBI, seguro, suministros… mensuales, trimestrales o anuales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Hausgeld, Grundsteuer, Versicherung, Nebenkosten hinzu – monatlich, vierteljährlich oder jährlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez charges de copropriété, taxe foncière, assurance, factures… mensuelles, trimestrielles ou annuelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi condominio, IMU, assicurazione, bollette… mensili, trimestrali o annuali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione condomínio, IPTU, seguro, contas… mensais, trimestrais ou anuais."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف رسوم المجتمع والضريبة العقارية والتأمين والفواتير… شهريًا أو ربع سنويًا أو سنويًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोसाइटी शुल्क, संपत्ति कर, बीमा, बिल… मासिक, तिमाही या वार्षिक जोड़ें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加物业费、房产税、保险、水电账单……按月、季度或年度。"
          }
        }
      }
    },
