    "exp.actual.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilities change every month. Record what the bill really was: the alerts compare it with the previous ones and warn you of big increases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los suministros cambian cada mes. Anota lo que costó la factura: las alertas la comparan con las anteriores y te avisan de las subidas fuertes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebenkosten ändern sich jeden Monat. Erfasse, was die Rechnung wirklich war: Die Hinweise vergleichen sie mit den vorherigen und warnen dich vor starken Anstiegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les charges changent chaque mois. Saisissez le montant réel de la facture : les alertes le comparent aux précédents et vous préviennent des fortes hausses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le utenze cambiano ogni mese. Registra quanto era davvero la bolletta: gli avvisi la confrontano con le precedenti e ti segnalano i rincari forti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os consumos mudam todos os meses. Registe quanto custou realmente a fatura: os alertas comparam-na com as anteriores e avisam-no de subidas fortes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتغير المرافق كل شهر. سجّل قيمة الفاتورة الفعلية: تقارنها التنبيهات بالفواتير السابقة وتحذّرك من الزيادات الكبيرة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोगिताएँ हर माह बदलती हैं। बिल की असली राशि दर्ज करें: अलर्ट उसकी पिछले बिलों से तुलना करते हैं और बड़ी वृद्धि पर चेतावनी देते हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水电杂费每月都会变化。请录入账单的实际金额:提醒功能会将其与此前账单比较,并在大幅上涨时通知你。"
          }
        }
      }
    },
