          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données n'ont pas pu être lues"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere i tuoi dati"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os seus dados"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
