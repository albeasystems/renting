    "coll.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add tenants to your rooms to start ticking collections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade inquilinos a tus habitaciones para empezar a marcar cobros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen Zimmern Mieter hinzu, um Zahlungen abzuhaken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des locataires à vos chambres pour commencer à cocher les encaissements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi inquilini alle stanze per iniziare a spuntare gli incassi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione inquilinos aos seus quartos para começar a marcar recebimentos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مستأجرين إلى غرفك لبدء تحديد الدفعات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान पर टिक लगाने के लिए अपने कमरों में किरायेदार जोड़ें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给房间添加租客后即可开始勾选收租。"
          }
        }
