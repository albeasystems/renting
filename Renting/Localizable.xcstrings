    "upd.section.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a year, on the contract anniversary, with the index agreed in the contract. The new rent is due from the month after the written notification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al año, en el aniversario del contrato y con el índice pactado. La nueva renta es exigible desde el mes siguiente a la notificación por escrito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal jährlich zum Vertragsjubiläum mit dem vereinbarten Index. Die neue Miete ist ab dem Monat nach der schriftlichen Mitteilung fällig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par an, à la date anniversaire du contrat, avec l'indice convenu. Le nouveau loyer est exigible à partir du mois suivant la notification écrite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta l'anno, all'anniversario del contratto e con l'indice pattuito. Il nuovo canone è dovuto dal mese successivo alla comunicazione scritta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por ano, no aniversário do contrato e com o índice acordado. A nova renda é exigível a partir do mês seguinte à notificação por escrito."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرة في السنة، في ذكرى العقد وبالمؤشر المتفق عليه. يستحق الإيجار الجديد من الشهر التالي للإخطار الكتابي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साल में एक बार, अनुबंध की वर्षगाँठ पर, तय सूचकांक से। नया किराया लिखित सूचना के अगले माह से देय है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每年一次,在合同周年日按约定指数调整。新租金自书面通知后的下一个月起生效。"
          }
        }
      }
    },
