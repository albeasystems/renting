    "props.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its rooms, tenants, payments and expenses will be deleted too. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se borrarán sus habitaciones, inquilinos, cobros y gastos. No se puede deshacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zimmer, Mieter, Zahlungen und Ausgaben werden ebenfalls gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses chambres, locataires, paiements et dépenses seront aussi supprimés. Action irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati anche stanze, inquilini, incassi e spese. L'azione non si può annullare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quartos, inquilinos, pagamentos e despesas também serão excluídos. Não é possível desfazer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم أيضًا حذف الغرف والمستأجرين والدفعات والمصروفات. لا يمكن التراجع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके कमरे, किरायेदार, भुगतान और खर्च भी हट जाएँगे। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其房间、租客、收款和支出也将一并删除,且无法撤销。"
          }
        }
      }
    },
