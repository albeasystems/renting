    "upd.cap.irav": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The IRAV is the ceiling: an update cannot exceed it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El IRAV es el techo: la actualización no puede superarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der IRAV ist die Obergrenze: eine Anpassung darf ihn nicht überschreiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IRAV est le plafond : la révision ne peut pas le dépasser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IRAV è il tetto: l'adeguamento non può superarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O IRAV é o teto: a atualização não o pode exceder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "IRAV هو السقف: لا يجوز أن يتجاوزه التحديث."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "IRAV सीमा है: अद्यतन इससे अधिक नहीं हो सकता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IRAV 为上限,调整幅度不得超过。"
          }
        }
      }
    },
    "upd.cap.decree": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RDL 29/2026: without a new agreement, updates between 08/10/2026 and 31/12/2027 cannot exceed 2%. Pending validation by Congress: check the BOE before notifying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RDL 29/2026: sin nuevo pacto, las actualizaciones entre el 08/10/2026 y el 31/12/2027 no pueden superar el 2 %. Pendiente de convalidación en el Congreso: consulta el BOE antes de notificar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RDL 29/2026: ohne neue Vereinbarung dürfen Anpassungen zwischen 08.10.2026 und 31.12.2027 2 % nicht übersteigen. Zustimmung des Parlaments steht aus: vor der Mitteilung das BOE prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RDL 29/2026 : sans nouvel accord, les révisions entre le 08/10/2026 et le 31/12/2027 ne peuvent dépasser 2 %. En attente de validation par le Congrès : consultez le BOE avant de notifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RDL 29/2026: senza nuovo accordo, gli adeguamenti tra l'08/10/2026 e il 31/12/2027 non possono superare il 2%. In attesa di convalida del Congresso: consulta il BOE prima di notificare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "RDL 29/2026: sem novo acordo, as atualizações entre 08/10/2026 e 31/12/2027 não podem exceder 2%. Pendente de convalidação no Congresso: consulte o BOE antes de notificar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "RDL 29/2026: دون اتفاق جديد لا يجوز أن تتجاوز التحديثات بين 08/10/2026 و31/12/2027 نسبة 2٪. بانتظار مصادقة البرلمان: راجع BOE قبل الإخطار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "RDL 29/2026: नए समझौते के बिना 08/10/2026 से 31/12/2027 के बीच अद्यतन 2% से अधिक नहीं हो सकता। कांग्रेस की पुष्टि लंबित: सूचना देने से पहले BOE देखें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RDL 29/2026:未重新约定时,2026/10/08 至 2027/12/31 的调整不得超过 2%。尚待议会确认,通知前请查阅 BOE。"
          }
        }
      }
    },
