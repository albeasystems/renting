    "cloud.enable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your homes, tenants, payments and expenses will be uploaded to your private iCloud and merged with what your other devices already synced. Deleting something later deletes it on all your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus viviendas, inquilinos, cobros y gastos se subirán a tu iCloud privado y se combinarán con lo que ya hayan sincronizado tus otros dispositivos. Si luego borras algo, se borra en todos tus dispositivos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wohnungen, Mieter, Zahlungen und Ausgaben werden in dein privates iCloud hochgeladen und mit dem zusammengeführt, was deine anderen Geräte bereits synchronisiert haben. Wenn du später etwas löschst, wird es auf allen deinen Geräten gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos logements, locataires, paiements et dépenses seront envoyés vers votre iCloud privé et fusionnés avec ce que vos autres appareils ont déjà synchronisé. Si vous supprimez quelque chose ensuite, c'est supprimé sur tous vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi immobili, inquilini, pagamenti e spese verranno caricati nel tuo iCloud privato e uniti a ciò che gli altri dispositivi hanno già sincronizzato. Se in seguito elimini qualcosa, viene eliminato su tutti i tuoi dispositivi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus imóveis, inquilinos, pagamentos e despesas serão enviados para o seu iCloud privado e juntados ao que os seus outros dispositivos já sincronizaram. Se depois apagar algo, é apagado em todos os seus dispositivos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُرفع عقاراتك ومستأجروك ودفعاتك ومصروفاتك إلى iCloud الخاص بك وتُدمج مع ما زامنته أجهزتك الأخرى. وإذا حذفت شيئًا لاحقًا فسيُحذف على جميع أجهزتك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके आवास, किरायेदार, भुगतान और खर्च आपके निजी iCloud में अपलोड होंगे और आपके अन्य डिवाइस ने जो पहले सिंक किया है उसके साथ मिल जाएँगे। बाद में कुछ हटाने पर वह आपके सभी डिवाइस से हट जाएगा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的房产、租客、收款和支出将上传到你的私有 iCloud,并与其他设备已同步的内容合并。之后删除某项内容,会在你所有设备上一并删除。"
          }
        }
      }
    },
    "cloud.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete my data from iCloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar mis datos de iCloud"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Daten aus iCloud löschen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer mes données d'iCloud"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina i miei dati da iCloud"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar os meus dados do iCloud"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف بياناتي من iCloud"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud से मेरा डेटा हटाएँ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 iCloud 删除我的数据"
          }
        }
      }
    },
    "cloud.delete.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the copy in iCloud and turns sync off. The data on this device is kept; your other devices keep theirs too but stop syncing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la copia en iCloud y desactiva la sincronización. Los datos de este dispositivo se conservan; tus otros dispositivos conservan los suyos pero dejan de sincronizar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt die Kopie in iCloud und schaltet die Synchronisierung aus. Die Daten auf diesem Gerät bleiben erhalten; deine anderen Geräte behalten ihre ebenfalls, synchronisieren aber nicht mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime la copie dans iCloud et désactive la synchronisation. Les données de cet appareil sont conservées ; vos autres appareils gardent aussi les leurs mais ne se synchronisent plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove la copia in iCloud e disattiva la sincronizzazione. I dati su questo dispositivo vengono conservati; anche gli altri dispositivi mantengono i loro ma smettono di sincronizzare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove a cópia no iCloud e desativa a sincronização. Os dados deste dispositivo mantêm-se; os seus outros dispositivos também mantêm os deles, mas deixam de sincronizar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل النسخة في iCloud ويوقف المزامنة. تبقى البيانات على هذا الجهاز؛ وتحتفظ أجهزتك الأخرى ببياناتها أيضًا لكنها تتوقف عن المزامنة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud की प्रति हटाता है और सिंक बंद करता है। इस डिवाइस का डेटा बना रहता है; आपके अन्य डिवाइस भी अपना डेटा रखते हैं पर सिंक करना बंद कर देते हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 iCloud 中的副本并关闭同步。本设备上的数据会保留;你的其他设备也保留各自的数据,但不再同步。"
          }
        }
      }
    },
