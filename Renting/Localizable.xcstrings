    "pro.sub.legal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple Account at purchase confirmation. The subscription renews automatically every month at the price shown unless you cancel it at least 24 hours before the end of the current period. Manage or cancel it in Settings › Apple Account › Subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se carga a tu cuenta de Apple al confirmar la compra. La suscripción se renueva automáticamente cada mes al precio indicado, salvo que la canceles al menos 24 horas antes de que termine el periodo en curso. Puedes gestionarla o cancelarla en Ajustes › Cuenta de Apple › Suscripciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wird bei Kaufbestätigung deinem Apple-Account belastet. Das Abo verlängert sich jeden Monat automatisch zum angezeigten Preis, sofern du es nicht mindestens 24 Stunden vor Ablauf des laufenden Zeitraums kündigst. Verwalten oder kündigen unter Einstellungen › Apple-Account › Abonnements."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité de votre compte Apple à la confirmation de l'achat. L'abonnement se renouvelle automatiquement chaque mois au prix indiqué, sauf résiliation au moins 24 heures avant la fin de la période en cours. Gérez-le ou résiliez-le dans Réglages › Compte Apple › Abonnements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento viene addebitato sul tuo account Apple alla conferma dell'acquisto. L'abbonamento si rinnova automaticamente ogni mese al prezzo indicato, salvo disdetta almeno 24 ore prima della fine del periodo in corso. Gestiscilo o annullalo in Impostazioni › Account Apple › Abbonamenti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é cobrado na sua conta Apple na confirmação da compra. A subscrição renova-se automaticamente todos os meses ao preço indicado, a menos que a cancele pelo menos 24 horas antes do fim do período em curso. Gira ou cancele em Definições › Conta Apple › Subscrições."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخصم المبلغ من حسابك في Apple عند تأكيد الشراء. يتجدد الاشتراك تلقائيًا كل شهر بالسعر المعروض ما لم تُلغِه قبل 24 ساعة على الأقل من نهاية الفترة الحالية. يمكنك إدارته أو إلغاؤه من الإعدادات › حساب Apple › الاشتراكات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीद की पुष्टि पर भुगतान आपके Apple खाते से लिया जाता है। सदस्यता हर महीने दिखाई गई कीमत पर अपने-आप नवीनीकृत होती है, जब तक आप चालू अवधि समाप्त होने से कम से कम 24 घंटे पहले इसे रद्द न करें। इसे सेटिंग › Apple खाता › सदस्यताएँ में प्रबंधित या रद्द करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认购买时将从你的 Apple 账户扣款。订阅将按所示价格每月自动续订,除非你在当前周期结束前至少 24 小时取消。可在 设置 › Apple 账户 › 订阅 中管理或取消。"
          }
        }
      }
    },
    "store.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase is waiting for approval. It will unlock when it is approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra está pendiente de aprobación. Se activará cuando la aprueben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wartet auf Genehmigung. Er wird freigeschaltet, sobald er genehmigt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat est en attente d'approbation. Il sera débloqué dès son approbation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto è in attesa di approvazione. Si sbloccherà quando verrà approvato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra aguarda aprovação. Será desbloqueada quando for aprovada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشراء بانتظار الموافقة. سيُفعَّل عند الموافقة عليه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीद स्वीकृति की प्रतीक्षा में है। स्वीकृत होते ही यह अनलॉक हो जाएगी।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买正在等待批准,批准后将自动解锁。"
          }
        }
      }
    },
    "store.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
