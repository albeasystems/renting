    "mgmt.form.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A percentage of the rent collected each month, without the utilities tenants pay on top. The commission appears every month in Expenses and counts as a deductible expense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un porcentaje del alquiler cobrado cada mes, sin incluir los suministros que pagan los inquilinos aparte. La comisión aparece cada mes en Gastos y cuenta como gasto deducible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Prozentsatz der jeden Monat eingegangenen Miete, ohne die separat gezahlten Nebenkosten. Die Provision erscheint jeden Monat unter Ausgaben und zählt als absetzbare Ausgabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pourcentage du loyer encaissé chaque mois, sans les charges payées à part par les locataires. La commission apparaît chaque mois dans Dépenses et compte comme dépense déductible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una percentuale del canone incassato ogni mese, escluse le utenze pagate a parte dagli inquilini. La commissione compare ogni mese in Spese e conta come spesa deducibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma percentagem da renda recebida todos os meses, sem os consumos que os inquilinos pagam à parte. A comissão aparece todos os meses em Despesas e conta como despesa dedutível."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسبة من الإيجار المحصَّل كل شهر، دون المرافق التي يدفعها المستأجرون بشكل منفصل. تظهر العمولة كل شهر في المصروفات وتُحتسب مصروفًا قابلًا للخصم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर महीने वसूले गए किराये का प्रतिशत, किरायेदारों द्वारा अलग से दी गई उपयोगिताओं को छोड़कर। कमीशन हर महीने खर्च में दिखता है और कटौती योग्य खर्च गिना जाता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按每月已收租金的百分比计算,不含租客另付的水电杂费。佣金每月显示在支出中,并计为可抵扣费用。"
          }
        }
      }
    },
