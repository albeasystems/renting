    "backup.import.message %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup has: %1$@.\nYou have now: %2$@.\nEverything you have now will be replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia tiene: %1$@.\nAhora tienes: %2$@.\nSe sustituirá todo lo que tienes ahora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung enthält: %1$@.\nJetzt hast du: %2$@.\nAlles, was du jetzt hast, wird ersetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde contient : %1$@.\nVous avez actuellement : %2$@.\nTout ce que vous avez actuellement sera remplacé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia contiene: %1$@.\nOra hai: %2$@.\nTutto ciò che hai ora verrà sostituito."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia tem: %1$@.\nAgora tem: %2$@.\nTudo o que tem agora será substituído."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي النسخة على: %1$@.\nلديك الآن: %2$@.\nسيُستبدل كل ما لديك الآن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप में है: %1$@।\nअभी आपके पास है: %2$@।\nअभी का सब कुछ बदल दिया जाएगा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包含:%1$@。\n当前拥有:%2$@。\n当前的所有数据都将被替换。"
          }
        }
      }
    },
    "backup.import.message_cloud %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup has: %1$@.\nYou have now: %2$@.\nEverything you have now will be replaced, and iCloud will be updated with these data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia tiene: %1$@.\nAhora tienes: %2$@.\nSe sustituirá todo lo que tienes ahora y iCloud se actualizará con estos datos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung enthält: %1$@.\nJetzt hast du: %2$@.\nAlles, was du jetzt hast, wird ersetzt, und iCloud wird mit diesen Daten aktualisiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde contient : %1$@.\nVous avez actuellement : %2$@.\nTout ce que vous avez actuellement sera remplacé et iCloud sera mis à jour avec ces données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia contiene: %1$@.\nOra hai: %2$@.\nTutto ciò che hai ora verrà sostituito e iCloud verrà aggiornato con questi dati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia tem: %1$@.\nAgora tem: %2$@.\nTudo o que tem agora será substituído e o iCloud será atualizado com estes dados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي النسخة على: %1$@.\nلديك الآن: %2$@.\nسيُستبدل كل ما لديك الآن وسيتم تحديث iCloud بهذه البيانات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप में है: %1$@।\nअभी आपके पास है: %2$@।\nअभी का सब कुछ बदल दिया जाएगा और iCloud को इस डेटा से अपडेट किया जाएगा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包含:%1$@。\n当前拥有:%2$@。\n当前的所有数据都将被替换,iCloud 也将用这些数据更新。"
          }
        }
      }
    },
