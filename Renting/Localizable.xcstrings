    "red.auto.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chosen automatically from the contract date and the type of let. Change it when editing the tenant or in the Tax tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegida automáticamente según la fecha del contrato y el tipo de alquiler. Puedes cambiarla al editar el inquilino o en la pestaña Fiscal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch nach Vertragsdatum und Vermietungsart gewählt. Änderbar beim Bearbeiten des Mieters oder im Tab Steuern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisie automatiquement selon la date du bail et le type de location. Modifiable dans la fiche du locataire ou l'onglet Fiscal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scelta automaticamente in base alla data del contratto e al tipo di affitto. Modificabile nell'inquilino o nella scheda Fisco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhida automaticamente pela data do contrato e o tipo de arrendamento. Pode alterá-la ao editar o inquilino ou no separador Fiscal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُختار تلقائيًا حسب تاريخ العقد ونوع الإيجار. يمكنك تغييرها عند تعديل المستأجر أو في تبويب الضرائب."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुबंध तिथि और किराये के प्रकार से स्वचालित रूप से चुनी गई। किरायेदार संपादित करते समय या कर टैब में बदलें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据合同日期和出租类型自动选择。可在编辑租客或税务标签中修改。"
          }
        }
      }
    },
    "red.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spanish income tax reduces the positive net yield of letting a home as the tenant's permanent residence: contracts before 26/05/2023 keep 60%; later ones get 50% (or 60, 70 or 90% if they meet the conditions). Seasonal lets get none. It is split between contracts by the rent each one brought in. Check your case with your tax advisor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el IRPF, el rendimiento neto positivo del alquiler de vivienda habitual se reduce: los contratos anteriores al 26/05/2023 mantienen el 60 %; los posteriores, el 50 % (o el 60, 70 o 90 % si cumplen los requisitos). La temporada no tiene reducción. Se reparte entre contratos según el alquiler de cada uno. Confirma tu caso con tu gestor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die spanische Einkommensteuer ermäßigt den positiven Nettoertrag aus der Vermietung als Hauptwohnsitz: Verträge vor dem 26.05.2023 behalten 60 %, spätere 50 % (oder 60, 70 bzw. 90 % bei Erfüllung der Bedingungen). Befristete Vermietung erhält keine. Aufgeteilt nach der Miete jedes Vertrags. Prüfe deinen Fall mit deinem Steuerberater."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impôt espagnol réduit le rendement net positif de la location d'une résidence principale : les baux antérieurs au 26/05/2023 gardent 60 % ; les suivants 50 % (ou 60, 70 ou 90 % sous conditions). Le saisonnier n'en bénéficie pas. Répartie entre baux selon le loyer de chacun. Vérifiez votre cas avec votre conseiller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IRPF spagnola riduce il rendimento netto positivo dell'affitto come abitazione principale: i contratti anteriori al 26/05/2023 mantengono il 60%; i successivi il 50% (o 60, 70 o 90% se ne hanno i requisiti). Il transitorio non ha riduzione. Ripartita tra contratti in base al canone di ciascuno. Verifica il tuo caso con il commercialista."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O IRPF espanhol reduz o rendimento líquido positivo do arrendamento de habitação permanente: contratos anteriores a 26/05/2023 mantêm 60%; os posteriores 50% (ou 60, 70 ou 90% se cumprirem os requisitos). A temporada não tem redução. É repartida entre contratos pela renda de cada um. Confirme o seu caso com o seu contabilista."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخفّض ضريبة الدخل الإسبانية صافي العائد الموجب لتأجير مسكن دائم: العقود قبل 26/05/2023 تحتفظ بـ60٪، واللاحقة 50٪ (أو 60 أو 70 أو 90٪ إن استوفت الشروط). لا تخفيض للإيجار الموسمي. يُوزَّع بين العقود حسب إيجار كل عقد. راجع حالتك مع مستشارك الضريبي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पेन का आयकर स्थायी निवास के किराये की सकारात्मक शुद्ध आय घटाता है: 26/05/2023 से पहले के अनुबंधों पर 60%; बाद वालों पर 50% (या शर्तें पूरी होने पर 60, 70 या 90%)। मौसमी किराये पर कोई छूट नहीं। हर अनुबंध के किराये के अनुपात में बाँटी जाती है। अपने कर सलाहकार से पुष्टि करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "西班牙所得税对作为租客常住住所出租的正净收益给予减免:2023/05/26 前的合同保持 60%;之后的为 50%(符合条件可为 60%、70% 或 90%)。短期季节租无减免。按各合同租金比例分摊。请向税务顾问确认。"
          }
        }
      }
    },
