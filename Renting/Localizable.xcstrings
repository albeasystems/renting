    "kpi.cov.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares what tenants pay for utilities on top of the rent with the electricity, water, gas and internet bills you pay. Below 100 % you are paying part of their consumption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara lo que pagan los inquilinos por suministros además del alquiler con las facturas de luz, agua, gas e internet que pagas tú. Por debajo del 100 % estás pagando parte de su consumo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht, was Mieter zusätzlich zur Miete für Nebenkosten zahlen, mit den Strom-, Wasser-, Gas- und Internetrechnungen, die du bezahlst. Unter 100 % zahlst du einen Teil ihres Verbrauchs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare ce que les locataires paient pour les charges en plus du loyer avec les factures d'électricité, d'eau, de gaz et d'internet que vous réglez. En dessous de 100 %, vous payez une partie de leur consommation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta ciò che gli inquilini pagano per le utenze oltre al canone con le bollette di luce, acqua, gas e internet che paghi tu. Sotto il 100 % stai pagando una parte dei loro consumi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara o que os inquilinos pagam por consumos além da renda com as faturas de luz, água, gás e internet que paga. Abaixo de 100 % está a pagar parte do consumo deles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقارن ما يدفعه المستأجرون للمرافق فوق الإيجار بفواتير الكهرباء والماء والغاز والإنترنت التي تدفعها أنت. إن كانت أقل من 100 % فأنت تدفع جزءًا من استهلاكهم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किराये के अलावा किरायेदार उपयोगिताओं के लिए जो देते हैं, उसकी तुलना उन बिजली, पानी, गैस और इंटरनेट बिलों से करता है जो आप भरते हैं। 100 % से कम होने पर आप उनके उपभोग का एक हिस्सा चुका रहे हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把租客在租金之外为水电杂费支付的金额,与你支付的电、水、燃气和网络账单作比较。低于 100 % 说明你在替他们承担部分用量。"
          }
        }
      }
    },
    "kpi.cov.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilities charged to tenants ÷ utility bills. Record the real bills so the figure is exact. To improve it: raise the flat utilities amount (it does not count for the manager or for tax income) or bill by consumption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suministros cobrados a inquilinos ÷ facturas de suministros. Anota las facturas reales para que la cifra sea exacta. Para mejorarla: sube la cantidad fija de suministros (no cuenta para el gestor ni como ingreso fiscal) o factura por consumo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Mieter berechnete Nebenkosten ÷ Nebenkostenrechnungen. Erfasse die echten Rechnungen, damit der Wert genau ist. So verbesserst du ihn: die Nebenkostenpauschale erhöhen (sie zählt weder für den Verwalter noch als steuerpflichtiges Einkommen) oder nach Verbrauch abrechnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charges facturées aux locataires ÷ factures de charges. Saisissez les vraies factures pour que le chiffre soit exact. Pour l'améliorer : augmentez le forfait de charges (il ne compte ni pour le gestionnaire ni comme revenu fiscal) ou facturez à la consommation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utenze addebitate agli inquilini ÷ bollette delle utenze. Registra le bollette reali perché la cifra sia esatta. Per migliorarla: aumenta l'importo forfettario delle utenze (non conta per il gestore né come reddito fiscale) oppure addebita in base ai consumi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumos cobrados aos inquilinos ÷ faturas de consumos. Registe as faturas reais para que o valor seja exato. Para a melhorar: aumente o valor fixo dos consumos (não conta para o gestor nem como rendimento fiscal) ou cobre por consumo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المرافق المحمَّلة على المستأجرين ÷ فواتير المرافق. سجّل الفواتير الفعلية ليكون الرقم دقيقًا. لتحسينها: ارفع المبلغ الثابت للمرافق (فهو لا يُحتسب للمدير ولا كدخل ضريبي) أو حاسب بحسب الاستهلاك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किरायेदारों से वसूली उपयोगिताएँ ÷ उपयोगिता बिल। आँकड़ा सटीक रहे, इसके लिए असली बिल दर्ज करें। इसे सुधारने के लिए: उपयोगिताओं की निश्चित राशि बढ़ाएँ (यह न प्रबंधक के लिए गिनी जाती है, न कर-योग्य आय के रूप में) या उपभोग के आधार पर बिल बनाएँ।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向租客收取的水电杂费 ÷ 水电杂费账单。录入真实账单,数字才准确。改善方法:提高水电杂费的固定金额(它不计入管理人佣金基数,也不算应税收入),或按实际用量收费。"
          }
        }
      }
    },
