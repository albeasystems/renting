    "cloud.f.sync.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone and iPad always show the same homes, tenants, payments and expenses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone y iPad muestran siempre las mismas viviendas, inquilinos, cobros y gastos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone und iPad zeigen immer dieselben Wohnungen, Mieter, Zahlungen und Ausgaben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone et iPad affichent toujours les mêmes logements, locataires, paiements et dépenses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone e iPad mostrano sempre gli stessi immobili, inquilini, pagamenti e spese."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone e iPad mostram sempre os mesmos imóveis, inquilinos, pagamentos e despesas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض iPhone وiPad دائمًا العقارات والمستأجرين والدفعات والمصروفات نفسها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone और iPad पर हमेशा वही आवास, किरायेदार, भुगतान और खर्च दिखते हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 和 iPad 始终显示相同的房产、租客、收款和支出。"
          }
        }
      }
    },
